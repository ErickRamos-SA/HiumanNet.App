<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Piezas de ASP.NET Core que comparten los dos anfitriones: la API y el portal
    web. Infrastructure no depende de ASP.NET a propósito; lo que necesita
    HttpContext o el enrutamiento, y es igual en ambos anfitriones, vive aquí.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>HuimanNet.Hosting</RootNamespace>
    <!--
      La consume la API publicada con Native AOT: cualquier advertencia IL2xxx /
      IL3xxx que aparezca aquí hay que resolverla, no silenciarla.
    -->
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <!--
      Los endpoints mínimos se declaran en este ensamblado, así que el generador
      de delegados tiene que correr aquí: sin él, la API publicada con AOT
      recurriría a reflexión para enlazar sus parámetros.
    -->
    <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HuimanNet.Contracts\HuimanNet.Contracts.csproj" />
    <ProjectReference Include="..\HuimanNet.Infrastructure\HuimanNet.Infrastructure.csproj" />
  </ItemGroup>

</Project>
