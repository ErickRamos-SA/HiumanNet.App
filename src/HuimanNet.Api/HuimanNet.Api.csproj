<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>HuimanNet.Api</RootNamespace>
    <OutputType>Exe</OutputType>

    <!-- Native AOT: arranque en frío mínimo y baja huella (ESPECIFICACION.md §6). -->
    <PublishAot>true</PublishAot>
    <!--
      Globalizacion completa: Microsoft.Data.SqlClient no admite el modo
      invariante (lanza "Globalization Invariant Mode is not supported" al abrir
      la conexion) porque necesita las culturas para las intercalaciones de SQL
      Server. En contenedores Linux la imagen debe incluir ICU (libicu).
    -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <EventSourceSupport>false</EventSourceSupport>
    <StackTraceSupport>false</StackTraceSupport>

    <!-- Enlace de configuración generado en compilación, sin reflexión. -->
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>

    <!-- Sin controladores MVC: los endpoints se declaran con Minimal APIs. -->
    <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>

    <UserSecretsId>huimannet-api</UserSecretsId>
  </PropertyGroup>

  <!--
    Conmutadores de característica: recortan de raíz rutas que la API no usa y
    que, de conservarse, arrastrarían reflexión al binario nativo.
  -->
  <PropertyGroup>
    <EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>
    <EnableUnsafeUTF7Encoding>false</EnableUnsafeUTF7Encoding>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <XmlResolverIsNetworkingEnabledByDefault>false</XmlResolverIsNetworkingEnabledByDefault>
  </PropertyGroup>

  <!--
    ESTADO DE COMPATIBILIDAD CON AOT (verificado con el analizador de recorte):
    todos los ensamblados de HuimanNet están limpios. Las únicas advertencias
    IL2xxx provienen de Microsoft.Data.SqlClient y de su dependencia
    System.Configuration.ConfigurationManager, en rutas que esta solución NO
    ejecuta: tipos definidos por el usuario (UDT), SqlVector, atestación de
    enclaves y proveedores de autenticación declarados en app.config.
    El acceso a SQL Server se hace por cadena de conexión, nunca por
    configuración reflexiva.

    Por eso la publicación NO usa -warnaserror de forma global: el flujo de CI
    falla si aparece una advertencia IL en un ensamblado *de HuimanNet*, que es
    la señal que sí importa. Consulte .github/workflows/ci.yml.
  -->

  <ItemGroup>
    <ProjectReference Include="..\HuimanNet.Domain\HuimanNet.Domain.csproj" />
    <ProjectReference Include="..\HuimanNet.Contracts\HuimanNet.Contracts.csproj" />
    <ProjectReference Include="..\HuimanNet.Application\HuimanNet.Application.csproj" />
    <ProjectReference Include="..\HuimanNet.Infrastructure\HuimanNet.Infrastructure.csproj" />
    <ProjectReference Include="..\HuimanNet.Hosting\HuimanNet.Hosting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
  </ItemGroup>

</Project>
