<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>HuimanNet.Web</RootNamespace>

    <!--
      Los componentes .razor generan clases públicas sin documentación XML.
      Exigir CS1591 aquí sólo produciría ruido; el estándar de documentación
      (ESPECIFICACION.md §7) se aplica al código C# de la solución.
    -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    <UserSecretsId>huimannet-web</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HuimanNet.Domain\HuimanNet.Domain.csproj" />
    <ProjectReference Include="..\HuimanNet.Contracts\HuimanNet.Contracts.csproj" />
    <ProjectReference Include="..\HuimanNet.Application\HuimanNet.Application.csproj" />
    <ProjectReference Include="..\HuimanNet.Infrastructure\HuimanNet.Infrastructure.csproj" />
    <ProjectReference Include="..\HuimanNet.Hosting\HuimanNet.Hosting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
    <PackageReference Include="Azure.Storage.Queues" />
    <!--
      El envío de correo vive aquí y no en Infrastructure a propósito: la API se
      publica con Native AOT y no debe enlazar el SDK de Communication Services.
      La web (JIT) es el anfitrión natural del trabajador de avisos.
    -->
    <PackageReference Include="Azure.Communication.Email" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Console" />
  </ItemGroup>

</Project>
