@inject Traductor T

<!DOCTYPE html>
<html lang="@(T.Idioma == Idioma.Ingles ? "en" : "es")">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="app.css" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%232f5bea'/%3E%3Ctext x='16' y='22' font-family='Segoe UI,Arial' font-size='17' font-weight='700' fill='white' text-anchor='middle'%3EH%3C/text%3E%3C/svg%3E" />
    <HeadOutlet @rendermode="ModoDeRenderizado" />
</head>

<body>
    <Routes @rendermode="ModoDeRenderizado" />
    <script src="_framework/blazor.web.js"></script>
    <script src="js/huimannet.js"></script>
</body>

</html>

@code {
    // Sin prerenderizado: cada página se carga una sola vez, ya en el circuito,
    // en lugar de consultar la base de datos dos veces por visita.
    private static readonly IComponentRenderMode ModoInteractivo = new InteractiveServerRenderMode(prerender: false);

    /// <summary>Obtiene o establece el contexto de la petición inicial.</summary>
    /// <value>Lo aporta el servidor al renderizar el documento.</value>
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    /// <summary>
    /// Obtiene el modo de renderizado de la página pedida. Las marcadas con
    /// <c>[ExcludeFromInteractiveRouting]</c> (acceso, error) se sirven
    /// estáticas para poder escribir cookies con formularios normales.
    /// </summary>
    /// <value>Servidor interactivo sin prerenderizado, o <c>null</c> para estático.</value>
    private IComponentRenderMode? ModoDeRenderizado
        => HttpContext.AcceptsInteractiveRouting() ? ModoInteractivo : null;

    /// <inheritdoc/>
    protected override void OnInitialized() => T.Cambiar(IdiomaDeLaPeticion.Detectar(HttpContext));
}
