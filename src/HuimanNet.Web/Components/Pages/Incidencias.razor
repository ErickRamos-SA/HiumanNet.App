@page "/incidencias"
@inherits ComponenteDelPortal

<PageTitle>@T["incidencias.titulo"] · HuimanNet</PageTitle>

<div class="encabezado-pagina">
    <div>
        <h1>@T["incidencias.titulo"]</h1>
        <p class="subtitulo">@T["incidencias.subtitulo"]</p>
    </div>
</div>

<Mensajes Error="@MensajeDeError" Exito="@MensajeDeExito" />

@if (_importacion is { Errores.Count: > 0 } importacion)
{
    <div class="aviso aviso-advertencia">
        <Icono Nombre="alerta" Tamano="18" />
        <div>
            <strong>@T.Formato("incidencias.erroresDeImportacion", importacion.Errores.Count)</strong>
            <ul class="lista-errores">
                @foreach (string error in importacion.Errores.Take(50))
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    </div>
}

@if (FaltaEmpresa)
{
    <AvisoDeEmpresa />
}
else
{
    <section class="tarjeta">
        <div class="formulario">
            <div class="campo">
                <label for="periodo">@T["comun.periodo"]</label>
                <select id="periodo" value="@(_periodoId?.ToString() ?? string.Empty)" @onchange="CambiarPeriodoAsync">
                    @if (_periodos.Count == 0)
                    {
                        <option value="">@T["periodos.sinPeriodos"]</option>
                    }
                    @foreach (PeriodoDto periodo in _periodos)
                    {
                        <option value="@periodo.Id">@periodo.Clave · @periodo.Descripcion (@T.Enumerado(periodo.Estado))</option>
                    }
                </select>
            </div>
            @if (PuedeImportar)
            {
                @* Los archivos se intercambian por período: aquí sólo se elige cuál de los ya subidos importar. *@
                <div class="campo">
                    <label for="archivo-incidencias">@T["incidencias.archivoDelPeriodo"]</label>
                    @if (_archivos.Count == 0)
                    {
                        <span class="ayuda">
                            @T["incidencias.sinArchivos"]
                            @if (_periodoId is { } periodoActual)
                            {
                                <a href="@($"periodos/{periodoActual}/documentos")">@T["incidencias.irADocumentos"]</a>
                            }
                        </span>
                    }
                    else
                    {
                        <div class="acciones">
                            <select id="archivo-incidencias" value="@(_archivoId?.ToString() ?? string.Empty)"
                                    @onchange="e => _archivoId = Guid.TryParse(e.Value?.ToString(), out Guid id) ? id : null">
                                @foreach (DocumentoDto archivo in _archivos)
                                {
                                    <option value="@archivo.Id">@archivo.NombreArchivo · @Fecha(archivo.FechaSolicitud)</option>
                                }
                            </select>
                            <button type="button" class="boton" disabled="@(EstaCargando || _archivoId is null)" title="@T["incidencias.importarAyuda"]" @onclick="ImportarAsync">
                                <Icono Nombre="subir" /> @T["incidencias.importar"]
                            </button>
                        </div>
                    }
                    <span class="ayuda">@T["incidencias.formatoDeArchivoAyuda"]</span>
                </div>
            }
        </div>
    </section>

    @if (_periodoId is not null)
    {
        IReadOnlyList<IncidenciaDto> filtradas = Filtradas();
        int totalPaginas = Math.Max(1, (filtradas.Count + TamanoPagina - 1) / TamanoPagina);
        int pagina = Math.Min(_pagina, totalPaginas);

        <section class="tarjeta tarjeta-tabla">
            <div class="barra-herramientas">
                <div class="buscador">
                    <Icono Nombre="buscar" Tamano="18" />
                    <input type="search" placeholder="@T["incidencias.buscar"]" @bind="_texto" @bind:event="oninput" @bind:after="() => _pagina = 1" />
                </div>
                <span class="espaciador"></span>
                <span class="tenue">@T.Formato("incidencias.resumen", _filas.Count(f => f.Id is not null), _filas.Count)</span>
            </div>

            @if (filtradas.Count == 0)
            {
                <div class="vacio">
                    <Icono Nombre="incidencias" Tamano="36" />
                    <p>@T["incidencias.vacio"]</p>
                </div>
            }
            else
            {
                <div class="tabla-contenedor">
                    <table class="tabla tabla-compacta">
                        <thead>
                            <tr>
                                <th>@T["empleados.clave"]</th>
                                <th>@T["incidencias.empleado"]</th>
                                <th>@T["contratos.esquema"]</th>
                                <th class="numero">@T["incidencias.dias"]</th>
                                <th class="numero">@T["incidencias.vacaciones"]</th>
                                <th class="numero">@T["incidencias.ausentismos"]</th>
                                <th class="numero">@T["incidencias.incapacidades"]</th>
                                <th class="numero">@T["incidencias.horasDobles"]</th>
                                <th class="numero">@T["incidencias.horasTriples"]</th>
                                <th class="numero">@T["incidencias.gratificacion"]</th>
                                <th class="numero">@T["incidencias.otrosDescuentos"]</th>
                                <th>@T["incidencias.movimiento"]</th>
                                <th>@T["comun.estado"]</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (IncidenciaDto fila in filtradas.Skip((pagina - 1) * TamanoPagina).Take(TamanoPagina))
                            {
                                <tr>
                                    <td><strong>@fila.ClaveEmpleado</strong></td>
                                    <td>
                                        <div class="celda-principal">
                                            <span>@fila.NombreEmpleado</span>
                                            <span class="tenue">@fila.RazonSocialNombre</span>
                                        </div>
                                    </td>
                                    <td><span class="etiqueta etiqueta-info">@T.Enumerado(fila.Esquema)</span></td>
                                    <td class="numero">@Numero(fila.DiasPeriodo)</td>
                                    <td class="numero">@Numero(fila.Vacaciones)</td>
                                    <td class="numero">@Numero(fila.Ausentismos)</td>
                                    <td class="numero">@Numero(fila.Incapacidades)</td>
                                    <td class="numero">@Numero(fila.HorasDobles)</td>
                                    <td class="numero">@Numero(fila.HorasTriples)</td>
                                    <td class="numero">@Moneda(fila.Gratificacion)</td>
                                    <td class="numero">@Moneda(fila.OtrosDescuentos)</td>
                                    <td>@T.Enumerado(fila.TipoDeMovimiento)</td>
                                    <td>
                                        @if (fila.Id is null)
                                        {
                                            <span class="tenue">@T["incidencias.sinCaptura"]</span>
                                        }
                                        else
                                        {
                                            <span class="etiqueta etiqueta-ok" title="@($"{fila.CapturadoPor} · {(fila.FechaCaptura is { } f ? Fecha(f) : string.Empty)}")">@T["incidencias.capturada"]</span>
                                        }
                                    </td>
                                    <td class="acciones-fila">
                                        <button type="button" class="boton-icono" title="@T["comun.editar"]" @onclick="() => Editar(fila)"><Icono Nombre="editar" Tamano="18" /></button>
                                        @if (fila.Id is not null)
                                        {
                                            <button type="button" class="boton-icono" title="@T["incidencias.restablecer"]" @onclick="() => _porEliminar = fila"><Icono Nombre="eliminar" Tamano="18" /></button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (totalPaginas > 1)
                {
                    <div class="paginacion">
                        <button type="button" class="boton boton-pequeno" disabled="@(pagina <= 1)" @onclick="() => _pagina = pagina - 1">@T["comun.anterior"]</button>
                        <span class="tenue">@T.Formato("comun.paginaDe", pagina, totalPaginas)</span>
                        <button type="button" class="boton boton-pequeno" disabled="@(pagina >= totalPaginas)" @onclick="() => _pagina = pagina + 1">@T["comun.siguiente"]</button>
                    </div>
                }
            }
        </section>
    }
}

<Dialogo Visible="_edicion is not null" Titulo="@T["incidencias.editar"]" Ancho="true" AlCerrar="() => _edicion = null">
    <ChildContent>
        @if (_edicion is { } m)
        {
            <p class="tenue">@m.Empleado · @T.Enumerado(m.Esquema)</p>
            <div class="formulario formulario-3">
                <div class="seccion-formulario"><h3>@T["incidencias.grupoAsistencia"]</h3></div>
                <CampoNumerico Etiqueta="@T["incidencias.dias"]" @bind-Valor="m.DiasPeriodo" Minimo="0" />
                <CampoNumerico Etiqueta="@T["incidencias.vacaciones"]" @bind-Valor="m.Vacaciones" Minimo="0" />
                <CampoNumerico Etiqueta="@T["incidencias.ausentismos"]" @bind-Valor="m.Ausentismos" Minimo="0" />
                <CampoNumerico Etiqueta="@T["incidencias.incapacidades"]" @bind-Valor="m.Incapacidades" Minimo="0" />
                <CampoNumerico Etiqueta="@T["incidencias.festivos"]" @bind-Valor="m.Festivos" Minimo="0" />
                <CampoNumerico Etiqueta="@T["incidencias.domingos"]" @bind-Valor="m.DomingosTrabajados" Minimo="0" />

                <div class="seccion-formulario"><h3>@T["incidencias.grupoTiempoExtra"]</h3></div>
                <CampoNumerico Etiqueta="@T["incidencias.horasDobles"]" @bind-Valor="m.HorasDobles" Minimo="0" />
                <CampoNumerico Etiqueta="@T["incidencias.horasTriples"]" @bind-Valor="m.HorasTriples" Minimo="0" />
                <CampoNumerico Etiqueta="@T["incidencias.horasDescontadas"]" @bind-Valor="m.HorasDescontadas" Minimo="0" />

                <div class="seccion-formulario"><h3>@T["incidencias.grupoPercepciones"]</h3></div>
                <CampoNumerico Etiqueta="@T["incidencias.gratificacion"]" @bind-Valor="m.Gratificacion" />
                <CampoNumerico Etiqueta="@T["incidencias.reembolsos"]" @bind-Valor="m.Reembolsos" />
                <CampoNumerico Etiqueta="@T["incidencias.teletrabajo"]" @bind-Valor="m.Teletrabajo" />
                <CampoNumerico Etiqueta="@T["incidencias.aguinaldo"]" @bind-Valor="m.Aguinaldo" />
                <CampoNumerico Etiqueta="@T["incidencias.finiquito"]" @bind-Valor="m.Finiquito" />

                <div class="seccion-formulario"><h3>@T["incidencias.grupoDeducciones"]</h3></div>
                <CampoNumerico Etiqueta="@T["incidencias.cafeteria"]" @bind-Valor="m.Cafeteria" />
                <CampoNumerico Etiqueta="@T["incidencias.otrosDescuentos"]" @bind-Valor="m.OtrosDescuentos" />
                <CampoNumerico Etiqueta="@T["incidencias.prestamoPersonal"]" @bind-Valor="m.PrestamoPersonal" />
                <CampoNumerico Etiqueta="@T["incidencias.descuentosFiscales"]" @bind-Valor="m.DescuentosFiscales" />
                <CampoNumerico Etiqueta="@T["incidencias.fonacot"]" @bind-Valor="m.FonacotCapturado" />

                <div class="seccion-formulario"><h3>@T["incidencias.grupoSindicato"]</h3></div>
                <CampoNumerico Etiqueta="@T["incidencias.descuentoSindical"]" @bind-Valor="m.DescuentoSindicalAdicional" Ayuda="@T["incidencias.descuentoSindicalAyuda"]" />
                <CampoNumerico Etiqueta="@T["incidencias.ajusteSindical"]" @bind-Valor="m.AjusteSindical" Ayuda="@T["incidencias.ajusteSindicalAyuda"]" />

                <div class="seccion-formulario"><h3>@T["incidencias.grupoOtros"]</h3></div>
                <div class="campo">
                    <label for="isr-manual">@T["incidencias.isrManual"]</label>
                    <input id="isr-manual" type="number" step="any" @bind="m.IsrManual" />
                    <span class="ayuda">@T["incidencias.isrManualAyuda"]</span>
                </div>
                <div class="campo">
                    <label for="movimiento">@T["incidencias.movimiento"]</label>
                    <select id="movimiento" @bind="m.TipoDeMovimiento">
                        @foreach (TipoDeMovimiento tipo in Enum.GetValues<TipoDeMovimiento>())
                        {
                            <option value="@tipo">@T.Enumerado(tipo)</option>
                        }
                    </select>
                </div>
                <div class="campo campo-ancho">
                    <label for="observaciones">@T["incidencias.observaciones"]</label>
                    <input id="observaciones" type="text" maxlength="500" @bind="m.Observaciones" />
                </div>
            </div>
        }
    </ChildContent>
    <Pie>
        <button type="button" class="boton" @onclick="() => _edicion = null">@T["comun.cancelar"]</button>
        <button type="button" class="boton boton-primario" disabled="@EstaCargando" @onclick="GuardarAsync">@T["comun.guardar"]</button>
    </Pie>
</Dialogo>

<Dialogo Visible="_porEliminar is not null" Titulo="@T["incidencias.restablecer"]" AlCerrar="() => _porEliminar = null">
    <ChildContent>
        <p>@T.Formato("incidencias.confirmarRestablecer", _porEliminar?.NombreEmpleado ?? string.Empty)</p>
    </ChildContent>
    <Pie>
        <button type="button" class="boton" @onclick="() => _porEliminar = null">@T["comun.cancelar"]</button>
        <button type="button" class="boton boton-peligro" disabled="@EstaCargando" @onclick="EliminarAsync">@T["incidencias.restablecer"]</button>
    </Pie>
</Dialogo>

@code {
    /// <summary>Filas por página.</summary>
    private const int TamanoPagina = Paginacion.TamanoDeTablaEnPantalla;

    private IReadOnlyList<PeriodoDto> _periodos = [];
    private IReadOnlyList<IncidenciaDto> _filas = [];
    private IReadOnlyList<DocumentoDto> _archivos = [];
    private Guid? _archivoId;
    private Guid? _periodoId;
    private string? _texto;
    private int _pagina = 1;
    private ResultadoDeImportacionDto? _importacion;
    private ModeloIncidencia? _edicion;
    private IncidenciaDto? _porEliminar;

    /// <summary>Período indicado en la dirección.</summary>
    [SupplyParameterFromQuery(Name = "periodoId")]
    public Guid? PeriodoIdDeRuta { get; set; }

    /// <inheritdoc/>
    protected override bool DependeDeEmpresa => true;

    /// <inheritdoc/>
    protected override async Task CargarDatosAsync()
    {
        _filas = [];
        _importacion = null;

        if (FaltaEmpresa)
        {
            _periodos = [];
            _periodoId = null;
            return;
        }

        _periodos = await Casos.ConsultarAsync<ListarPeriodosQuery, IReadOnlyList<PeriodoDto>>(
            new ListarPeriodosQuery(EmpresaDeConsulta, IncluirCerrados: false));

        _periodoId = _periodos.FirstOrDefault(p => p.Id == PeriodoIdDeRuta)?.Id ?? _periodos.FirstOrDefault()?.Id;
        await CargarFilasAsync();
    }

    /// <inheritdoc/>
    protected override Task AlCambiarEmpresaAsync()
    {
        PeriodoIdDeRuta = null;
        return CargarDatosAsync();
    }

    /// <summary>Importa quien captura incidencias: la empresa (lo suyo) y nómina.</summary>
    private bool PuedeImportar => ContextoDeUsuario.Puede(AccionDelSistema.CapturarIncidencias);

    /// <summary>Carga las filas del período elegido y sus archivos importables.</summary>
    /// <returns>Tarea que finaliza al cargarlas.</returns>
    private async Task CargarFilasAsync()
    {
        _pagina = 1;
        _filas = _periodoId is { } periodoId
            ? await Casos.ConsultarAsync<ListarIncidenciasQuery, IReadOnlyList<IncidenciaDto>>(new ListarIncidenciasQuery(periodoId, EmpresaDeConsulta))
            : [];

        await CargarArchivosAsync();
    }

    /// <summary>Archivos de incidencias ya disponibles en el período, del más reciente al más antiguo.</summary>
    private async Task CargarArchivosAsync()
    {
        _archivos = PuedeImportar && _periodoId is { } periodoId
            ? await Casos.ConsultarAsync<ListarDocumentosPorPeriodoQuery, IReadOnlyList<DocumentoDto>>(
                new ListarDocumentosPorPeriodoQuery(periodoId, TipoDocumento.Incidencia, SoloDescargables: true, EmpresaDeConsulta))
            : [];

        if (_archivos.All(a => a.Id != _archivoId))
        {
            _archivoId = _archivos.FirstOrDefault()?.Id;
        }
    }

    /// <summary>Filtra las filas por clave, nombre o razón social.</summary>
    /// <returns>Las filas visibles.</returns>
    private IReadOnlyList<IncidenciaDto> Filtradas()
    {
        if (string.IsNullOrWhiteSpace(_texto))
        {
            return _filas;
        }

        string texto = _texto.Trim();
        return _filas
            .Where(f => f.ClaveEmpleado.Contains(texto, StringComparison.OrdinalIgnoreCase)
                || f.NombreEmpleado.Contains(texto, StringComparison.OrdinalIgnoreCase)
                || f.RazonSocialNombre.Contains(texto, StringComparison.OrdinalIgnoreCase))
            .ToList();
    }

    /// <summary>Cambia el período elegido y carga sus filas.</summary>
    /// <param name="argumentos">Evento del selector de período.</param>
    /// <returns>Tarea que finaliza al cargar las filas.</returns>
    private Task CambiarPeriodoAsync(ChangeEventArgs argumentos)
    {
        _periodoId = Guid.TryParse(argumentos.Value?.ToString(), out Guid id) ? id : null;
        LimpiarMensajes();
        _importacion = null;
        return EjecutarAsync(CargarFilasAsync);
    }

    /// <summary>Abre el formulario con las cantidades de una fila.</summary>
    /// <param name="fila">Fila elegida.</param>
    private void Editar(IncidenciaDto fila)
    {
        LimpiarMensajes();
        _edicion = ModeloIncidencia.Desde(fila);
    }

    /// <summary>Guarda la incidencia del formulario y recarga sin perder la página.</summary>
    /// <returns>Tarea que finaliza al recargar.</returns>
    private Task GuardarAsync() => EjecutarAsync(async () =>
    {
        if (_edicion is not { } modelo || _periodoId is not { } periodoId)
        {
            return;
        }

        await Casos.EjecutarAsync<GuardarIncidenciaCommand, IncidenciaDto>(
            new GuardarIncidenciaCommand(modelo.ARequest(periodoId, EmpresaDeConsulta)));

        _edicion = null;
        MensajeDeExito = T.Formato("incidencias.guardada", modelo.Empleado);
        int pagina = _pagina;
        await CargarFilasAsync();
        _pagina = pagina;
    });

    /// <summary>
    /// Elimina la incidencia confirmada; el contrato vuelve a calcularse con el
    /// período completo sin novedades.
    /// </summary>
    /// <returns>Tarea que finaliza al recargar.</returns>
    private Task EliminarAsync() => EjecutarAsync(async () =>
    {
        if (_porEliminar is not { Id: { } incidenciaId } fila)
        {
            return;
        }

        await Casos.EjecutarAsync(new EliminarIncidenciaCommand(incidenciaId, EmpresaDeConsulta));
        _porEliminar = null;
        MensajeDeExito = T.Formato("incidencias.restablecida", fila.NombreEmpleado);
        await CargarFilasAsync();
    });

    /// <summary>Importa las incidencias del archivo elegido y recarga las filas.</summary>
    /// <returns>Tarea que finaliza al recargar.</returns>
    private Task ImportarAsync() => EjecutarAsync(async () =>
    {
        LimpiarMensajes();
        _importacion = null;

        if (_archivoId is not { } documentoId)
        {
            return;
        }

        _importacion = await Casos.EjecutarAsync<ImportarIncidenciasCommand, ResultadoDeImportacionDto>(
            new ImportarIncidenciasCommand(documentoId, EmpresaDeConsulta));

        MensajeDeExito = T.Formato("incidencias.importadas", _importacion.FilasLeidas, _importacion.Creadas, _importacion.Actualizadas);
        await CargarFilasAsync();
    });

    /// <summary>Estado editable de una incidencia.</summary>
    private sealed class ModeloIncidencia
    {
        /// <summary>Obtiene el contrato de la fila.</summary>
        /// <value>Identificador del contrato.</value>
        public Guid ContratoId { get; init; }

        /// <summary>Obtiene la clave y el nombre del empleado, para el título del formulario.</summary>
        /// <value>Texto a mostrar.</value>
        public string Empleado { get; init; } = string.Empty;

        /// <summary>Obtiene el esquema del contrato.</summary>
        /// <value>Decide qué campos se muestran.</value>
        public EsquemaDePago Esquema { get; init; }

        /// <summary>Obtiene o establece los días del período.</summary>
        /// <value>Mayor que cero.</value>
        public decimal DiasPeriodo { get; set; }

        /// <summary>Obtiene o establece los días de vacaciones.</summary>
        /// <value>Cantidad de días.</value>
        public decimal Vacaciones { get; set; }

        /// <summary>Obtiene o establece los días de ausentismo.</summary>
        /// <value>Cantidad de días.</value>
        public decimal Ausentismos { get; set; }

        /// <summary>Obtiene o establece los días de incapacidad.</summary>
        /// <value>Cantidad de días.</value>
        public decimal Incapacidades { get; set; }

        /// <summary>Obtiene o establece los festivos laborados.</summary>
        /// <value>Cantidad de días.</value>
        public decimal Festivos { get; set; }

        /// <summary>Obtiene o establece las horas extra dobles.</summary>
        /// <value>Cantidad de horas.</value>
        public decimal HorasDobles { get; set; }

        /// <summary>Obtiene o establece las horas extra triples.</summary>
        /// <value>Cantidad de horas.</value>
        public decimal HorasTriples { get; set; }

        /// <summary>Obtiene o establece los domingos trabajados.</summary>
        /// <value>Cantidad de domingos.</value>
        public decimal DomingosTrabajados { get; set; }

        /// <summary>Obtiene o establece las gratificaciones y bonos del período.</summary>
        /// <value>Importe en pesos.</value>
        public decimal Gratificacion { get; set; }

        /// <summary>Obtiene o establece los reembolsos.</summary>
        /// <value>Importe en pesos.</value>
        public decimal Reembolsos { get; set; }

        /// <summary>Obtiene o establece el apoyo por teletrabajo.</summary>
        /// <value>Importe en pesos.</value>
        public decimal Teletrabajo { get; set; }

        /// <summary>Obtiene o establece el importe de finiquito.</summary>
        /// <value>Importe en pesos.</value>
        public decimal Finiquito { get; set; }

        /// <summary>Obtiene o establece los gastos de cafetería.</summary>
        /// <value>Importe en pesos.</value>
        public decimal Cafeteria { get; set; }

        /// <summary>Obtiene o establece las horas a descontar.</summary>
        /// <value>Cantidad de horas.</value>
        public decimal HorasDescontadas { get; set; }

        /// <summary>Obtiene o establece otros descuentos personales.</summary>
        /// <value>Importe en pesos.</value>
        public decimal OtrosDescuentos { get; set; }

        /// <summary>Obtiene o establece el descuento de préstamo personal del período.</summary>
        /// <value>Importe en pesos.</value>
        public decimal PrestamoPersonal { get; set; }

        /// <summary>Obtiene o establece el aguinaldo pagado en el período.</summary>
        /// <value>Importe en pesos.</value>
        public decimal Aguinaldo { get; set; }

        /// <summary>Obtiene o establece otros descuentos del recibo fiscal.</summary>
        /// <value>Importe en pesos.</value>
        public decimal DescuentosFiscales { get; set; }

        /// <summary>Obtiene o establece el descuento FONACOT capturado.</summary>
        /// <value>Importe en pesos.</value>
        public decimal FonacotCapturado { get; set; }

        /// <summary>Obtiene o establece el descuento adicional del complemento sindical.</summary>
        /// <value>Importe en pesos.</value>
        public decimal DescuentoSindicalAdicional { get; set; }

        /// <summary>Obtiene o establece el ajuste manual al complemento sindical.</summary>
        /// <value>Importe positivo o negativo.</value>
        public decimal AjusteSindical { get; set; }

        /// <summary>Obtiene o establece la retención manual de ISR.</summary>
        /// <value><c>null</c> para calcularla.</value>
        public decimal? IsrManual { get; set; }

        /// <summary>Obtiene o establece el tipo de movimiento.</summary>
        /// <value>Ordinaria o finiquito.</value>
        public TipoDeMovimiento TipoDeMovimiento { get; set; }

        /// <summary>Obtiene o establece las observaciones.</summary>
        /// <value>Nota libre sobre los ajustes manuales.</value>
        public string? Observaciones { get; set; }

        /// <summary>Crea el modelo con las cantidades de una fila.</summary>
        /// <param name="d">Fila de incidencias.</param>
        /// <returns>El modelo editable.</returns>
        public static ModeloIncidencia Desde(IncidenciaDto d) => new()
        {
            ContratoId = d.ContratoId,
            Empleado = $"{d.ClaveEmpleado} · {d.NombreEmpleado}",
            Esquema = d.Esquema,
            DiasPeriodo = d.DiasPeriodo,
            Vacaciones = d.Vacaciones,
            Ausentismos = d.Ausentismos,
            Incapacidades = d.Incapacidades,
            Festivos = d.Festivos,
            HorasDobles = d.HorasDobles,
            HorasTriples = d.HorasTriples,
            DomingosTrabajados = d.DomingosTrabajados,
            Gratificacion = d.Gratificacion,
            Reembolsos = d.Reembolsos,
            Teletrabajo = d.Teletrabajo,
            Finiquito = d.Finiquito,
            Cafeteria = d.Cafeteria,
            HorasDescontadas = d.HorasDescontadas,
            OtrosDescuentos = d.OtrosDescuentos,
            PrestamoPersonal = d.PrestamoPersonal,
            Aguinaldo = d.Aguinaldo,
            DescuentosFiscales = d.DescuentosFiscales,
            FonacotCapturado = d.FonacotCapturado,
            DescuentoSindicalAdicional = d.DescuentoSindicalAdicional,
            AjusteSindical = d.AjusteSindical,
            IsrManual = d.IsrManual,
            TipoDeMovimiento = d.TipoDeMovimiento,
            Observaciones = d.Observaciones,
        };

        /// <summary>Arma la petición de guardado.</summary>
        /// <param name="periodoId">Período de la incidencia.</param>
        /// <param name="empresaId">Empresa de consulta; <c>null</c> para la empresa cliente.</param>
        /// <returns>La petición.</returns>
        public GuardarIncidenciaRequest ARequest(Guid periodoId, Guid? empresaId) => new(
            periodoId, ContratoId, empresaId, DiasPeriodo, Vacaciones, Ausentismos, Incapacidades, Festivos,
            HorasDobles, HorasTriples, DomingosTrabajados, Gratificacion, Reembolsos, Teletrabajo, Finiquito,
            Cafeteria, HorasDescontadas, OtrosDescuentos, PrestamoPersonal, Aguinaldo, DescuentosFiscales,
            FonacotCapturado, DescuentoSindicalAdicional, AjusteSindical, IsrManual, TipoDeMovimiento,
            string.IsNullOrWhiteSpace(Observaciones) ? null : Observaciones.Trim());
    }
}
