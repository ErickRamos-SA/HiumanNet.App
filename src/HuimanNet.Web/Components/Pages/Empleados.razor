@page "/empleados"
@inherits ComponenteDelPortal

<PageTitle>@T["empleados.titulo"] · HuimanNet</PageTitle>

<div class="encabezado-pagina">
    <div>
        <h1>@T["empleados.titulo"]</h1>
        <p class="subtitulo">@T["empleados.subtitulo"]</p>
    </div>
    @if (PuedeAdministrar)
    {
        <button type="button" class="boton boton-primario" @onclick="NuevoEmpleado">
            <Icono Nombre="agregar" /> @T["empleados.nuevo"]
        </button>
    }
</div>

<Mensajes Error="@MensajeDeError" Exito="@MensajeDeExito" />

<section class="tarjeta tarjeta-tabla">
    <div class="barra-herramientas">
        <div class="buscador">
            <Icono Nombre="buscar" Tamano="18" />
            <input type="search" placeholder="@T["empleados.buscar"]" @bind="_texto" @bind:after="BuscarAsync" />
        </div>
        @if (ContextoDeUsuario.EligeEmpresa)
        {
            <select value="@(_filtroEmpresa?.ToString() ?? string.Empty)" @onchange="CambiarFiltroDeEmpresaAsync" aria-label="@T["comun.empresa"]">
                <option value="">@(ContextoDeUsuario.EsTransversal ? T["empleados.todasLasEmpresas"] : T["empleados.todasMisEmpresas"])</option>
                @foreach (EmpresaDto empresa in _empresas)
                {
                    <option value="@empresa.Id">@empresa.RazonSocial</option>
                }
            </select>
        }
        <label class="casilla">
            <input type="checkbox" @bind="_soloActivos" @bind:after="BuscarAsync" /> @T["empleados.soloActivos"]
        </label>
        <span class="espaciador"></span>
        @if (_pagina is { } p)
        {
            <span class="tenue">@T.Formato("empleados.total", p.TotalElementos.ToString("N0", T.Cultura))</span>
        }
    </div>

    @if (_pagina is null || _pagina.Elementos.Count == 0)
    {
        <div class="vacio">
            <Icono Nombre="empleados" Tamano="36" />
            <p>@T["empleados.vacio"]</p>
        </div>
    }
    else
    {
        <div class="tabla-contenedor">
            <table class="tabla">
                <thead>
                    <tr>
                        <th>@T["empleados.clave"]</th>
                        <th>@T["comun.nombre"]</th>
                        @if (MostrarEmpresa)
                        {
                            <th>@T["comun.empresa"]</th>
                        }
                        <th>@T["empleados.esquemas"]</th>
                        <th>@T["razones.titulo"]</th>
                        <th class="numero">@T["empleados.contratosActivos"]</th>
                        <th>@T["comun.estado"]</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (EmpleadoResumenDto empleado in _pagina.Elementos)
                    {
                        <tr class="fila-seleccionable" @onclick="() => AbrirAsync(empleado)">
                            <td><strong>@empleado.Clave</strong></td>
                            <td>@empleado.NombreCompleto</td>
                            @if (MostrarEmpresa)
                            {
                                <td>@empleado.EmpresaRazonSocial</td>
                            }
                            <td>
                                @foreach (EsquemaDePago esquema in EsquemasDe(empleado.Esquemas))
                                {
                                    <span class="etiqueta etiqueta-info" style="margin-right:.25rem">@T.Enumerado(esquema)</span>
                                }
                            </td>
                            <td class="tenue">@empleado.RazonesSociales</td>
                            <td class="numero">@empleado.ContratosActivos</td>
                            <td>
                                <span class="etiqueta @(empleado.Activo ? "etiqueta-ok" : "etiqueta-error")">@(empleado.Activo ? T["comun.activo"] : T["comun.inactivo"])</span>
                            </td>
                            <td class="acciones-fila"><Icono Nombre="derecha" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (_pagina.TotalPaginas > 1)
        {
            <div class="paginacion">
                <button type="button" class="boton boton-pequeno" disabled="@(_numeroDePagina <= 1)" @onclick="() => IrAPaginaAsync(_numeroDePagina - 1)">@T["comun.anterior"]</button>
                <span class="tenue">@T.Formato("comun.paginaDe", _pagina.Pagina, _pagina.TotalPaginas)</span>
                <button type="button" class="boton boton-pequeno" disabled="@(_numeroDePagina >= _pagina.TotalPaginas)" @onclick="() => IrAPaginaAsync(_numeroDePagina + 1)">@T["comun.siguiente"]</button>
            </div>
        }
    }
</section>

@* ---- Detalle del empleado con sus contratos ---- *@
<Dialogo Visible="_vista == Vista.Detalle && _empleado is not null" Titulo="@(_empleado is { } e ? $"{e.Clave} · {e.NombreCompleto}" : string.Empty)" Ancho="true" AlCerrar="Cerrar">
    <ChildContent>
        @if (_empleado is { } e)
        {
            <div class="rejilla-2">
                <dl class="definiciones">
                    @if (ContextoDeUsuario.EligeEmpresa)
                    {
                        <dt>@T["comun.empresa"]</dt><dd>@NombreDeEmpresa(e.EmpresaId)</dd>
                    }
                    <dt>@T["empleados.rfc"]</dt><dd>@(e.Rfc ?? "—")</dd>
                    <dt>@T["empleados.curp"]</dt><dd>@(e.Curp ?? "—")</dd>
                    <dt>@T["empleados.nss"]</dt><dd>@(e.Nss ?? "—")</dd>
                    <dt>@T["empleados.fechaNacimiento"]</dt><dd>@(e.FechaNacimiento is { } f ? Fecha(f) : "—")</dd>
                </dl>
                <dl class="definiciones">
                    <dt>@T["comun.correo"]</dt><dd>@(e.Correo ?? "—")</dd>
                    <dt>@T["empleados.telefono"]</dt><dd>@(e.Telefono ?? "—")</dd>
                    <dt>@T["comun.estado"]</dt><dd>@(e.Activo ? T["comun.activo"] : T["comun.inactivo"])</dd>
                    <dt>@T["empleados.fechaAlta"]</dt><dd>@Fecha(e.FechaAlta)</dd>
                </dl>
            </div>

            <div class="tarjeta-cabecera" style="padding:1.25rem 0 .5rem">
                <h2>@T["contratos.titulo"]</h2>
                @if (PuedeAdministrar)
                {
                    <button type="button" class="boton boton-pequeno" @onclick="NuevoContratoAsync"><Icono Nombre="agregar" Tamano="16" /> @T["contratos.nuevo"]</button>
                }
            </div>
            <p class="tenue">@T["contratos.ayudaMixto"]</p>

            @if (e.Contratos.Count == 0)
            {
                <p class="tenue">@T["contratos.vacio"]</p>
            }
            else
            {
                <div class="tabla-contenedor">
                    <table class="tabla tabla-compacta">
                        <thead>
                            <tr>
                                <th>@T["razones.titulo"]</th>
                                <th>@T["contratos.esquema"]</th>
                                <th class="numero">@T["contratos.sueldoPeriodoReal"]</th>
                                <th class="numero">@T["contratos.sdFiscal"]</th>
                                <th class="numero">@T["contratos.sdi"]</th>
                                <th>@T["contratos.zona"]</th>
                                <th>@T["contratos.vigencia"]</th>
                                <th>@T["contratos.complemento"]</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (ContratoDto contrato in e.Contratos)
                            {
                                <tr>
                                    <td>
                                        <div class="celda-principal">
                                            <span>@contrato.RazonSocialNombre</span>
                                            <span class="tenue">@contrato.Puesto</span>
                                        </div>
                                    </td>
                                    <td><span class="etiqueta etiqueta-info">@T.Enumerado(contrato.Esquema)</span></td>
                                    <td class="numero">@Moneda(contrato.SueldoPeriodoReal)</td>
                                    <td class="numero">@Moneda(contrato.SalarioDiarioFiscal)</td>
                                    <td class="numero">@Moneda(contrato.SalarioDiarioIntegrado)</td>
                                    <td>@T.Enumerado(contrato.Zona)</td>
                                    <td>
                                        @Fecha(contrato.FechaAlta) – @(contrato.FechaBaja is { } baja ? Fecha(baja) : T["contratos.vigente"])
                                    </td>
                                    <td>@(contrato.PagaComplementoSindical ? T["comun.si"] : T["comun.no"])</td>
                                    <td class="acciones-fila">
                                        @if (PuedeAdministrar)
                                        {
                                            <button type="button" class="boton-icono" title="@T["comun.editar"]" @onclick="() => EditarContratoAsync(contrato)"><Icono Nombre="editar" Tamano="18" /></button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
    </ChildContent>
    <Pie>
        <button type="button" class="boton" @onclick="Cerrar">@T["comun.cerrar"]</button>
        @if (PuedeAdministrar)
        {
            <button type="button" class="boton boton-primario" @onclick="EditarEmpleado"><Icono Nombre="editar" /> @T["empleados.editar"]</button>
        }
    </Pie>
</Dialogo>

@* ---- Alta y edición del empleado ---- *@
<Dialogo Visible="_vista == Vista.Empleado && _modeloEmpleado is not null" Titulo="@(_modeloEmpleado?.Id is null ? T["empleados.nuevo"] : T["empleados.editar"])" AlCerrar="VolverDeEdicion">
    <ChildContent>
        @if (_modeloEmpleado is { } m)
        {
            <div class="formulario">
                @if (ContextoDeUsuario.EligeEmpresa && m.Id is null)
                {
                    <div class="campo campo-ancho">
                        <label for="empresa-empleado">@T["comun.empresa"]</label>
                        <select id="empresa-empleado" value="@(m.EmpresaId?.ToString() ?? string.Empty)"
                                @onchange="e => m.EmpresaId = Guid.TryParse(e.Value?.ToString(), out Guid id) ? id : null">
                            <option value="">@T["comun.seleccioneEmpresa"]</option>
                            @foreach (EmpresaDto empresa in _empresas)
                            {
                                <option value="@empresa.Id">@empresa.RazonSocial</option>
                            }
                        </select>
                    </div>
                }
                <div class="campo">
                    <label for="clave">@T["empleados.clave"]</label>
                    <input id="clave" type="text" maxlength="30" @bind="m.Clave" />
                </div>
                <div class="campo">
                    <label class="casilla" style="margin-top:1.6rem"><input type="checkbox" @bind="m.Activo" /> @T["comun.activo"]</label>
                </div>
                <div class="campo">
                    <label for="nombre">@T["comun.nombre"]</label>
                    <input id="nombre" type="text" maxlength="100" @bind="m.Nombre" />
                </div>
                <div class="campo">
                    <label for="paterno">@T["empleados.apellidoPaterno"]</label>
                    <input id="paterno" type="text" maxlength="100" @bind="m.ApellidoPaterno" />
                </div>
                <div class="campo">
                    <label for="materno">@T["empleados.apellidoMaterno"]</label>
                    <input id="materno" type="text" maxlength="100" @bind="m.ApellidoMaterno" />
                </div>
                <div class="campo">
                    <label for="nacimiento">@T["empleados.fechaNacimiento"]</label>
                    <input id="nacimiento" type="date" @bind="m.FechaNacimiento" />
                </div>
                <div class="campo">
                    <label for="rfc">@T["empleados.rfc"]</label>
                    <input id="rfc" type="text" maxlength="13" @bind="m.Rfc" />
                </div>
                <div class="campo">
                    <label for="curp">@T["empleados.curp"]</label>
                    <input id="curp" type="text" maxlength="18" @bind="m.Curp" />
                </div>
                <div class="campo">
                    <label for="nss">@T["empleados.nss"]</label>
                    <input id="nss" type="text" maxlength="11" @bind="m.Nss" />
                </div>
                <div class="campo">
                    <label for="telefono">@T["empleados.telefono"]</label>
                    <input id="telefono" type="text" maxlength="30" @bind="m.Telefono" />
                </div>
                <div class="campo campo-ancho">
                    <label for="correo">@T["comun.correo"]</label>
                    <input id="correo" type="email" maxlength="200" @bind="m.Correo" />
                </div>
            </div>
        }
    </ChildContent>
    <Pie>
        <button type="button" class="boton" @onclick="VolverDeEdicion">@T["comun.cancelar"]</button>
        <button type="button" class="boton boton-primario" disabled="@EstaCargando" @onclick="GuardarEmpleadoAsync">@T["comun.guardar"]</button>
    </Pie>
</Dialogo>

@* ---- Alta y edición de un contrato ---- *@
<Dialogo Visible="_vista == Vista.Contrato && _modeloContrato is not null" Titulo="@(_modeloContrato?.Id is null ? T["contratos.nuevo"] : T["contratos.editar"])" Ancho="true" AlCerrar="VolverAlDetalle">
    <ChildContent>
        @if (_modeloContrato is { } c)
        {
            <div class="formulario formulario-3">
                <div class="campo">
                    <label for="razon">@T["razones.titulo"]</label>
                    <select id="razon" value="@(c.RazonSocialId?.ToString() ?? string.Empty)" @onchange="e => c.RazonSocialId = Guid.TryParse(e.Value?.ToString(), out Guid id) ? id : null">
                        <option value="">@T["contratos.seleccioneRazon"]</option>
                        @foreach (RazonSocialDto razon in _razones)
                        {
                            <option value="@razon.Id">@razon.Nombre</option>
                        }
                    </select>
                </div>
                <div class="campo">
                    <label for="esquema">@T["contratos.esquema"]</label>
                    <select id="esquema" @bind="c.Esquema">
                        <option value="@EsquemaDePago.Imss">@T.Enumerado(EsquemaDePago.Imss)</option>
                        <option value="@EsquemaDePago.Sindicato">@T.Enumerado(EsquemaDePago.Sindicato)</option>
                        <option value="@EsquemaDePago.Honorarios">@T.Enumerado(EsquemaDePago.Honorarios)</option>
                    </select>
                </div>
                <div class="campo">
                    <label for="zona">@T["contratos.zona"]</label>
                    <select id="zona" @bind="c.Zona">
                        <option value="@ZonaSalarioMinimo.A">@T.Enumerado(ZonaSalarioMinimo.A)</option>
                        <option value="@ZonaSalarioMinimo.B">@T.Enumerado(ZonaSalarioMinimo.B)</option>
                    </select>
                </div>

                <div class="campo">
                    <label for="numero">@T["contratos.numeroTrabajador"]</label>
                    <input id="numero" type="text" maxlength="30" @bind="c.NumeroTrabajador" />
                </div>
                <div class="campo">
                    <label for="puesto">@T["contratos.puesto"]</label>
                    <input id="puesto" type="text" maxlength="100" @bind="c.Puesto" />
                </div>
                <div class="campo">
                    <label for="depto">@T["contratos.departamento"]</label>
                    <input id="depto" type="text" maxlength="100" @bind="c.Departamento" />
                </div>
                <div class="campo">
                    <label for="tipo">@T["contratos.tipoDeContrato"]</label>
                    <input id="tipo" type="text" maxlength="50" @bind="c.TipoDeContrato" />
                </div>
                <div class="campo">
                    <label for="alta">@T["contratos.fechaAlta"]</label>
                    <input id="alta" type="date" @bind="c.FechaAlta" />
                </div>
                <div class="campo">
                    <label for="baja">@T["contratos.fechaBaja"]</label>
                    <input id="baja" type="date" @bind="c.FechaBaja" />
                </div>

                <div class="seccion-formulario"><h3>@T["contratos.grupoSalario"]</h3></div>
                <CampoNumerico Etiqueta="@T["contratos.sueldoPeriodoReal"]" @bind-Valor="c.SueldoPeriodoReal" Minimo="0" Ayuda="@T["contratos.sueldoPeriodoRealAyuda"]" />
                <CampoNumerico Etiqueta="@T["contratos.sdFiscal"]" @bind-Valor="c.SalarioDiarioFiscal" Minimo="0" />
                <CampoNumerico Etiqueta="@T["contratos.sdi"]" @bind-Valor="c.SalarioDiarioIntegrado" Minimo="0" />
                <CampoNumerico Etiqueta="@T["contratos.bonoFijo"]" @bind-Valor="c.BonoFijo" Minimo="0" />
                <div class="campo campo-ancho">
                    <label class="casilla"><input type="checkbox" @bind="c.PagaComplementoSindical" /> @T["contratos.pagaComplemento"]</label>
                    <span class="ayuda">@T["contratos.pagaComplementoAyuda"]</span>
                </div>
                @if (c.Esquema == EsquemaDePago.Honorarios)
                {
                    <div class="campo campo-ancho">
                        <label class="casilla"><input type="checkbox" @bind="c.HonorariosAplicaIva" /> @T["contratos.honorariosIva"]</label>
                    </div>
                }

                <div class="seccion-formulario"><h3>@T["contratos.grupoCreditos"]</h3></div>
                <div class="campo">
                    <label for="infonavit">@T["contratos.infonavitTipo"]</label>
                    <select id="infonavit" @bind="c.InfonavitTipo">
                        @foreach (TipoDeCreditoInfonavit tipo in Enum.GetValues<TipoDeCreditoInfonavit>())
                        {
                            <option value="@tipo">@T.Enumerado(tipo)</option>
                        }
                    </select>
                </div>
                <CampoNumerico Etiqueta="@T["contratos.infonavitValor"]" @bind-Valor="c.InfonavitValor" Minimo="0" Deshabilitado="@(c.InfonavitTipo == TipoDeCreditoInfonavit.Ninguno)" />
                <CampoNumerico Etiqueta="@T["contratos.infonavitSeguro"]" @bind-Valor="c.InfonavitSeguroVivienda" Minimo="0" Deshabilitado="@(c.InfonavitTipo == TipoDeCreditoInfonavit.Ninguno)" />
                <CampoNumerico Etiqueta="@T["contratos.fonacot"]" @bind-Valor="c.FonacotMensual" Minimo="0" />
                <CampoNumerico Etiqueta="@T["contratos.prestamoFijo"]" @bind-Valor="c.PrestamoPersonalFijo" Minimo="0" />
                <CampoNumerico Etiqueta="@T["contratos.pensionImporte"]" @bind-Valor="c.PensionAlimenticiaImporte" Minimo="0" />
                <CampoNumerico Etiqueta="@T["contratos.pensionPorcentaje"]" @bind-Valor="c.PensionAlimenticiaPorcentaje" Minimo="0" Ayuda="@T["comun.fraccionAyuda"]" />
            </div>
        }
    </ChildContent>
    <Pie>
        <button type="button" class="boton" @onclick="VolverAlDetalle">@T["comun.cancelar"]</button>
        <button type="button" class="boton boton-primario" disabled="@EstaCargando" @onclick="GuardarContratoAsync">@T["comun.guardar"]</button>
    </Pie>
</Dialogo>

@code {
    private PaginaDto<EmpleadoResumenDto>? _pagina;
    private int _numeroDePagina = 1;
    private string? _texto;
    private bool _soloActivos = true;

    private IReadOnlyList<EmpresaDto> _empresas = [];
    private Guid? _filtroEmpresa;
    private bool _filtroInicializado;

    private Vista _vista = Vista.Ninguna;
    private EmpleadoDto? _empleado;
    private ModeloEmpleado? _modeloEmpleado;
    private ModeloContrato? _modeloContrato;
    private IReadOnlyList<RazonSocialDto> _razones = [];
    private Guid? _empresaDeLasRazones;

    /// <summary>Panel que se muestra junto a la lista.</summary>
    private enum Vista
    {
        /// <summary>Sólo la lista.</summary>
        Ninguna,

        /// <summary>Ficha del empleado con sus contratos.</summary>
        Detalle,

        /// <summary>Formulario del empleado.</summary>
        Empleado,

        /// <summary>Formulario de un contrato.</summary>
        Contrato,
    }

    /// <inheritdoc/>
    protected override bool DependeDeEmpresa => true;

    /// <summary>Alta y edición de empleados y contratos; el resto sólo consulta.</summary>
    private bool PuedeAdministrar => ContextoDeUsuario.Puede(AccionDelSistema.AdministrarEmpleados);

    /// <summary>La columna de empresa se muestra cuando se listan todas.</summary>
    private bool MostrarEmpresa => ContextoDeUsuario.EligeEmpresa && _filtroEmpresa is null;

    /// <summary>Empresa del filtro para el caso de uso; al cliente se la impone el servidor.</summary>
    private Guid? EmpresaDelFiltro => ContextoDeUsuario.EligeEmpresa ? _filtroEmpresa : null;

    /// <summary>Empresa del empleado abierto, para los roles transversales.</summary>
    private Guid? EmpresaDelEmpleado => ContextoDeUsuario.EligeEmpresa ? _empleado?.EmpresaId : null;

    /// <inheritdoc/>
    protected override async Task CargarDatosAsync()
    {
        _vista = Vista.Ninguna;

        if (ContextoDeUsuario.EligeEmpresa)
        {
            if (_empresas.Count == 0)
            {
                // Nómina y administración filtran entre todas; la empresa cliente, entre las suyas.
                _empresas = ContextoDeUsuario.EsTransversal
                    ? await Casos.ConsultarAsync<ListarEmpresasQuery, IReadOnlyList<EmpresaDto>>(new ListarEmpresasQuery(SoloActivas: true))
                    : ContextoDeUsuario.EmpresasDelUsuario;
            }

            if (!_filtroInicializado)
            {
                // Empieza con la empresa de trabajo de la cabecera; «Todas» se elige en el filtro.
                _filtroEmpresa = Estado.EmpresaId;
                _filtroInicializado = true;
            }
        }

        await CargarPaginaAsync();
    }

    /// <inheritdoc/>
    protected override Task AlCambiarEmpresaAsync()
    {
        _filtroEmpresa = Estado.EmpresaId;
        _numeroDePagina = 1;
        return CargarDatosAsync();
    }

    /// <summary>Carga la página actual con los filtros elegidos.</summary>
    /// <returns>Tarea que finaliza al cargarla.</returns>
    private async Task CargarPaginaAsync()
        => _pagina = await Casos.ConsultarAsync<ListarEmpleadosQuery, PaginaDto<EmpleadoResumenDto>>(
            new ListarEmpleadosQuery(EmpresaDelFiltro, _soloActivos, string.IsNullOrWhiteSpace(_texto) ? null : _texto.Trim(), _numeroDePagina, Paginacion.TamanoDeEmpleados));

    /// <summary>Filtra por otra empresa desde la primera página.</summary>
    /// <param name="argumentos">Evento del selector de empresa.</param>
    /// <returns>Tarea que finaliza al cargar la página.</returns>
    private Task CambiarFiltroDeEmpresaAsync(ChangeEventArgs argumentos)
    {
        _filtroEmpresa = Guid.TryParse(argumentos.Value?.ToString(), out Guid id) ? id : null;
        _numeroDePagina = 1;
        return EjecutarAsync(CargarPaginaAsync);
    }

    /// <summary>Aplica la búsqueda desde la primera página.</summary>
    /// <returns>Tarea que finaliza al cargar la página.</returns>
    private Task BuscarAsync()
    {
        _numeroDePagina = 1;
        return EjecutarAsync(CargarPaginaAsync);
    }

    /// <summary>Muestra otra página.</summary>
    /// <param name="pagina">Página, desde 1.</param>
    /// <returns>Tarea que finaliza al cargarla.</returns>
    private Task IrAPaginaAsync(int pagina)
    {
        _numeroDePagina = Math.Max(1, pagina);
        return EjecutarAsync(CargarPaginaAsync);
    }

    /// <summary>Convierte la lista de esquemas del resumen en valores del enumerado.</summary>
    /// <param name="esquemas">Nombres separados por comas.</param>
    /// <returns>Los esquemas reconocidos.</returns>
    private static IEnumerable<EsquemaDePago> EsquemasDe(string esquemas)
        => esquemas.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(e => Enum.TryParse(e, out EsquemaDePago esquema) ? esquema : EsquemaDePago.NoEspecificado)
            .Where(e => e != EsquemaDePago.NoEspecificado);

    /// <summary>Obtiene la razón social de una empresa del filtro.</summary>
    /// <param name="empresaId">Empresa.</param>
    /// <returns>La razón social, o cadena vacía si no está en la lista.</returns>
    private string NombreDeEmpresa(Guid empresaId)
        => _empresas.FirstOrDefault(e => e.Id == empresaId)?.RazonSocial ?? string.Empty;

    /// <summary>Abre la ficha de un empleado.</summary>
    /// <param name="resumen">Empleado elegido en la lista.</param>
    /// <returns>Tarea que finaliza al cargar la ficha.</returns>
    private Task AbrirAsync(EmpleadoResumenDto resumen) => EjecutarAsync(async () =>
    {
        LimpiarMensajes();
        _empleado = await Casos.ConsultarAsync<ObtenerEmpleadoQuery, EmpleadoDto>(
            new ObtenerEmpleadoQuery(resumen.Id, ContextoDeUsuario.EligeEmpresa ? resumen.EmpresaId : null));
        _vista = Vista.Detalle;
    });

    /// <summary>Cierra el panel y vuelve a la lista.</summary>
    private void Cerrar()
    {
        _vista = Vista.Ninguna;
        _empleado = null;
    }

    /// <summary>Abre el formulario de un empleado nuevo en la empresa filtrada o de trabajo.</summary>
    private void NuevoEmpleado()
    {
        LimpiarMensajes();
        _empleado = null;
        _modeloEmpleado = new ModeloEmpleado { EmpresaId = ContextoDeUsuario.EligeEmpresa ? _filtroEmpresa ?? Estado.EmpresaId : null };
        _vista = Vista.Empleado;
    }

    /// <summary>Abre el formulario con los datos del empleado abierto.</summary>
    private void EditarEmpleado()
    {
        if (_empleado is { } e)
        {
            _modeloEmpleado = ModeloEmpleado.Desde(e);
            _vista = Vista.Empleado;
        }
    }

    /// <summary>Cancela el formulario del empleado y vuelve a la ficha o a la lista.</summary>
    private void VolverDeEdicion() => _vista = _empleado is null ? Vista.Ninguna : Vista.Detalle;

    /// <summary>Cancela el formulario del contrato y vuelve a la ficha.</summary>
    private void VolverAlDetalle() => _vista = Vista.Detalle;

    /// <summary>Guarda el empleado del formulario y abre su ficha.</summary>
    /// <returns>Tarea que finaliza al abrir la ficha o al mostrar el error.</returns>
    private Task GuardarEmpleadoAsync() => EjecutarAsync(async () =>
    {
        if (_modeloEmpleado is not { } modelo)
        {
            return;
        }

        // Cada empleado pertenece a una empresa: el rol transversal la elige al darlo de alta.
        if (ContextoDeUsuario.EligeEmpresa && modelo.EmpresaId is null)
        {
            MostrarError(T["empleados.seleccioneEmpresaParaAlta"]);
            return;
        }

        EmpleadoDto guardado = await Casos.EjecutarAsync<GuardarEmpleadoCommand, EmpleadoDto>(
            new GuardarEmpleadoCommand(modelo.Id, modelo.ARequest(ContextoDeUsuario.EligeEmpresa ? modelo.EmpresaId : null)));

        MensajeDeExito = T.Formato("empleados.guardado", guardado.NombreCompleto);
        await CargarPaginaAsync();
        _empleado = guardado;
        _vista = Vista.Detalle;
    });

    /// <summary>Abre el formulario de un contrato nuevo; propone la razón social si sólo hay una.</summary>
    /// <returns>Tarea que finaliza al abrir el formulario.</returns>
    private Task NuevoContratoAsync() => EjecutarAsync(async () =>
    {
        await CargarRazonesAsync();
        _modeloContrato = new ModeloContrato { RazonSocialId = _razones.Count == 1 ? _razones[0].Id : null };
        _vista = Vista.Contrato;
    });

    /// <summary>Abre el formulario con los datos de un contrato.</summary>
    /// <param name="contrato">Contrato a editar.</param>
    /// <returns>Tarea que finaliza al abrir el formulario.</returns>
    private Task EditarContratoAsync(ContratoDto contrato) => EjecutarAsync(async () =>
    {
        await CargarRazonesAsync();
        _modeloContrato = ModeloContrato.Desde(contrato);
        _vista = Vista.Contrato;
    });

    /// <summary>Las razones sociales son las de la empresa del empleado abierto.</summary>
    private async Task CargarRazonesAsync()
    {
        Guid? empresa = _empleado?.EmpresaId;

        if (_razones.Count == 0 || _empresaDeLasRazones != empresa)
        {
            _razones = await Casos.ConsultarAsync<ListarRazonesSocialesQuery, IReadOnlyList<RazonSocialDto>>(
                new ListarRazonesSocialesQuery(EmpresaDelEmpleado, SoloActivas: true));
            _empresaDeLasRazones = empresa;
        }
    }

    /// <summary>Guarda el contrato del formulario y recarga la ficha y la lista.</summary>
    /// <returns>Tarea que finaliza al recargar o al mostrar el error.</returns>
    private Task GuardarContratoAsync() => EjecutarAsync(async () =>
    {
        if (_modeloContrato is not { } modelo || _empleado is not { } empleado)
        {
            return;
        }

        if (modelo.RazonSocialId is not { } razonSocialId)
        {
            MostrarError(T["contratos.seleccioneRazon"]);
            return;
        }

        await Casos.EjecutarAsync<GuardarContratoCommand, ContratoDto>(
            new GuardarContratoCommand(empleado.Id, modelo.Id, modelo.ARequest(EmpresaDelEmpleado, razonSocialId)));

        MensajeDeExito = T.Formato("contratos.guardado", empleado.NombreCompleto);
        _empleado = await Casos.ConsultarAsync<ObtenerEmpleadoQuery, EmpleadoDto>(new ObtenerEmpleadoQuery(empleado.Id, EmpresaDelEmpleado));
        _vista = Vista.Detalle;
        await CargarPaginaAsync();
    });

    /// <summary>Estado editable de un empleado.</summary>
    private sealed class ModeloEmpleado
    {
        /// <summary>Obtiene el identificador.</summary>
        /// <value><c>null</c> para un empleado nuevo.</value>
        public Guid? Id { get; init; }

        /// <summary>Obtiene o establece la empresa del empleado.</summary>
        /// <value>La elige el rol transversal; para la empresa cliente la impone el servidor.</value>
        public Guid? EmpresaId { get; set; }

        /// <summary>Obtiene o establece la clave del empleado.</summary>
        /// <value>Única en la empresa.</value>
        public string Clave { get; set; } = string.Empty;

        /// <summary>Obtiene o establece el nombre.</summary>
        /// <value>Obligatorio.</value>
        public string Nombre { get; set; } = string.Empty;

        /// <summary>Obtiene o establece el apellido paterno.</summary>
        /// <value>Obligatorio.</value>
        public string ApellidoPaterno { get; set; } = string.Empty;

        /// <summary>Obtiene o establece el apellido materno.</summary>
        /// <value>Opcional.</value>
        public string? ApellidoMaterno { get; set; }

        /// <summary>Obtiene o establece el RFC.</summary>
        /// <value>Se guarda en mayúsculas.</value>
        public string? Rfc { get; set; }

        /// <summary>Obtiene o establece la CURP.</summary>
        /// <value>Se guarda en mayúsculas.</value>
        public string? Curp { get; set; }

        /// <summary>Obtiene o establece el número de seguridad social.</summary>
        /// <value>Opcional.</value>
        public string? Nss { get; set; }

        /// <summary>Obtiene o establece la fecha de nacimiento.</summary>
        /// <value>Opcional.</value>
        public DateOnly? FechaNacimiento { get; set; }

        /// <summary>Obtiene o establece el correo.</summary>
        /// <value>Opcional.</value>
        public string? Correo { get; set; }

        /// <summary>Obtiene o establece el teléfono.</summary>
        /// <value>Opcional.</value>
        public string? Telefono { get; set; }

        /// <summary>Obtiene o establece si el empleado está activo.</summary>
        /// <value><c>true</c> para un empleado nuevo.</value>
        public bool Activo { get; set; } = true;

        /// <summary>Crea el modelo con los datos de un empleado.</summary>
        /// <param name="e">Empleado.</param>
        /// <returns>El modelo editable.</returns>
        public static ModeloEmpleado Desde(EmpleadoDto e) => new()
        {
            Id = e.Id,
            EmpresaId = e.EmpresaId,
            Clave = e.Clave,
            Nombre = e.Nombre,
            ApellidoPaterno = e.ApellidoPaterno,
            ApellidoMaterno = e.ApellidoMaterno,
            Rfc = e.Rfc,
            Curp = e.Curp,
            Nss = e.Nss,
            FechaNacimiento = e.FechaNacimiento,
            Correo = e.Correo,
            Telefono = e.Telefono,
            Activo = e.Activo,
        };

        /// <summary>Arma la petición con los textos normalizados.</summary>
        /// <param name="empresaId">Empresa que se envía; <c>null</c> para la empresa cliente.</param>
        /// <returns>La petición de guardado.</returns>
        public GuardarEmpleadoRequest ARequest(Guid? empresaId) => new(
            empresaId, Clave.Trim(), Nombre.Trim(), ApellidoPaterno.Trim(), Limpio(ApellidoMaterno),
            Limpio(Rfc)?.ToUpperInvariant(), Limpio(Curp)?.ToUpperInvariant(), Limpio(Nss), FechaNacimiento,
            Limpio(Correo), Limpio(Telefono), Activo);
    }

    /// <summary>Estado editable de un contrato.</summary>
    private sealed class ModeloContrato
    {
        /// <summary>Obtiene el identificador.</summary>
        /// <value><c>null</c> para un contrato nuevo.</value>
        public Guid? Id { get; init; }

        /// <summary>Obtiene o establece la razón social pagadora.</summary>
        /// <value>Obligatoria para guardar.</value>
        public Guid? RazonSocialId { get; set; }

        /// <summary>Obtiene o establece el esquema de pago.</summary>
        /// <value>IMSS para un contrato nuevo.</value>
        public EsquemaDePago Esquema { get; set; } = EsquemaDePago.Imss;

        /// <summary>Obtiene o establece el número de trabajador.</summary>
        /// <value>Opcional.</value>
        public string? NumeroTrabajador { get; set; }

        /// <summary>Obtiene o establece el puesto.</summary>
        /// <value>Opcional.</value>
        public string? Puesto { get; set; }

        /// <summary>Obtiene o establece el departamento.</summary>
        /// <value>Opcional.</value>
        public string? Departamento { get; set; }

        /// <summary>Obtiene o establece el tipo de contrato.</summary>
        /// <value>Opcional.</value>
        public string? TipoDeContrato { get; set; }

        /// <summary>Obtiene o establece el sueldo real del período.</summary>
        /// <value>Importe en pesos.</value>
        public decimal SueldoPeriodoReal { get; set; }

        /// <summary>Obtiene o establece el salario diario fiscal.</summary>
        /// <value>Importe en pesos.</value>
        public decimal SalarioDiarioFiscal { get; set; }

        /// <summary>Obtiene o establece el salario diario integrado.</summary>
        /// <value>Importe en pesos.</value>
        public decimal SalarioDiarioIntegrado { get; set; }

        /// <summary>Obtiene o establece la zona de salario mínimo.</summary>
        /// <value>Zona A para un contrato nuevo.</value>
        public ZonaSalarioMinimo Zona { get; set; } = ZonaSalarioMinimo.A;

        /// <summary>Obtiene o establece el tipo de crédito INFONAVIT.</summary>
        /// <value>Ninguno para un contrato nuevo.</value>
        public TipoDeCreditoInfonavit InfonavitTipo { get; set; } = TipoDeCreditoInfonavit.Ninguno;

        /// <summary>Obtiene o establece el valor del crédito INFONAVIT.</summary>
        /// <value>Importe, porcentaje o factor según el tipo.</value>
        public decimal InfonavitValor { get; set; }

        /// <summary>Obtiene o establece el seguro de vivienda INFONAVIT.</summary>
        /// <value>Importe en pesos.</value>
        public decimal InfonavitSeguroVivienda { get; set; }

        /// <summary>Obtiene o establece el descuento FONACOT mensual.</summary>
        /// <value>Importe en pesos.</value>
        public decimal FonacotMensual { get; set; }

        /// <summary>Obtiene o establece la pensión alimenticia fija.</summary>
        /// <value>Importe en pesos.</value>
        public decimal PensionAlimenticiaImporte { get; set; }

        /// <summary>Obtiene o establece la pensión alimenticia porcentual.</summary>
        /// <value>Fracción entre 0 y 1.</value>
        public decimal PensionAlimenticiaPorcentaje { get; set; }

        /// <summary>Obtiene o establece el descuento fijo de préstamo personal.</summary>
        /// <value>Importe en pesos.</value>
        public decimal PrestamoPersonalFijo { get; set; }

        /// <summary>Obtiene o establece el bono fijo.</summary>
        /// <value>Importe en pesos.</value>
        public decimal BonoFijo { get; set; }

        /// <summary>Obtiene o establece si los honorarios causan IVA.</summary>
        /// <value>Sólo se envía para el esquema honorarios.</value>
        public bool HonorariosAplicaIva { get; set; }

        /// <summary>Obtiene o establece si recibe complemento sindical.</summary>
        /// <value><c>true</c> si lo recibe.</value>
        public bool PagaComplementoSindical { get; set; }

        /// <summary>Obtiene o establece la fecha de alta.</summary>
        /// <value>Hoy para un contrato nuevo.</value>
        public DateOnly FechaAlta { get; set; } = DateOnly.FromDateTime(DateTime.Today);

        /// <summary>Obtiene o establece la fecha de baja.</summary>
        /// <value><c>null</c> si sigue vigente.</value>
        public DateOnly? FechaBaja { get; set; }

        /// <summary>Crea el modelo con los datos de un contrato.</summary>
        /// <param name="c">Contrato.</param>
        /// <returns>El modelo editable.</returns>
        public static ModeloContrato Desde(ContratoDto c) => new()
        {
            Id = c.Id,
            RazonSocialId = c.RazonSocialId,
            Esquema = c.Esquema,
            NumeroTrabajador = c.NumeroTrabajador,
            Puesto = c.Puesto,
            Departamento = c.Departamento,
            TipoDeContrato = c.TipoDeContrato,
            SueldoPeriodoReal = c.SueldoPeriodoReal,
            SalarioDiarioFiscal = c.SalarioDiarioFiscal,
            SalarioDiarioIntegrado = c.SalarioDiarioIntegrado,
            Zona = c.Zona,
            InfonavitTipo = c.InfonavitTipo,
            InfonavitValor = c.InfonavitValor,
            InfonavitSeguroVivienda = c.InfonavitSeguroVivienda,
            FonacotMensual = c.FonacotMensual,
            PensionAlimenticiaImporte = c.PensionAlimenticiaImporte,
            PensionAlimenticiaPorcentaje = c.PensionAlimenticiaPorcentaje,
            PrestamoPersonalFijo = c.PrestamoPersonalFijo,
            BonoFijo = c.BonoFijo,
            HonorariosAplicaIva = c.HonorariosAplicaIva,
            PagaComplementoSindical = c.PagaComplementoSindical,
            FechaAlta = c.FechaAlta,
            FechaBaja = c.FechaBaja,
        };

        /// <summary>Arma la petición con los textos normalizados.</summary>
        /// <param name="empresaId">Empresa del empleado; <c>null</c> para la empresa cliente.</param>
        /// <param name="razonSocialId">Razón social elegida.</param>
        /// <returns>La petición de guardado.</returns>
        public GuardarContratoRequest ARequest(Guid? empresaId, Guid razonSocialId) => new(
            empresaId, razonSocialId, Esquema, Limpio(NumeroTrabajador), Limpio(Puesto), Limpio(Departamento),
            Limpio(TipoDeContrato), SueldoPeriodoReal, SalarioDiarioFiscal, SalarioDiarioIntegrado, Zona,
            InfonavitTipo, InfonavitValor, InfonavitSeguroVivienda, FonacotMensual, PensionAlimenticiaImporte,
            PensionAlimenticiaPorcentaje, PrestamoPersonalFijo, BonoFijo,
            Esquema == EsquemaDePago.Honorarios && HonorariosAplicaIva, PagaComplementoSindical, FechaAlta, FechaBaja);
    }

    /// <summary>Normaliza un texto opcional.</summary>
    /// <param name="valor">Texto capturado.</param>
    /// <returns>El texto sin espacios en los extremos, o <c>null</c> si está vacío.</returns>
    private static string? Limpio(string? valor) =>string.IsNullOrWhiteSpace(valor) ? null : valor.Trim();
}
