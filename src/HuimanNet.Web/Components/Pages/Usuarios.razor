@page "/usuarios"
@inherits ComponenteDelPortal
@using HuimanNet.Domain.Services
@using HuimanNet.Infrastructure.Configuracion
@using Microsoft.Extensions.Options
@inject IOptions<OpcionesDeIdentidad> Identidad

<PageTitle>@T["usuarios.titulo"] · HuimanNet</PageTitle>

<div class="encabezado-pagina">
    <div>
        <h1>@T["usuarios.titulo"]</h1>
        <p class="subtitulo">@T["usuarios.subtitulo"]</p>
    </div>
    <button type="button" class="boton boton-primario" @onclick="Nuevo">
        <Icono Nombre="agregar" /> @T["usuarios.nuevo"]
    </button>
</div>

<Mensajes Error="@MensajeDeError" Exito="@MensajeDeExito" />

<section class="tarjeta tarjeta-tabla">
    <div class="barra-herramientas">
        <div class="buscador">
            <Icono Nombre="buscar" Tamano="18" />
            <input type="search" placeholder="@T["usuarios.buscar"]" @bind="_texto" @bind:event="oninput" />
        </div>
        <select value="@(_filtroEmpresa?.ToString() ?? string.Empty)" @onchange="CambiarFiltroEmpresaAsync" aria-label="@T["comun.empresa"]">
            <option value="">@T["comun.todas"]</option>
            @foreach (EmpresaDto empresa in _empresas)
            {
                <option value="@empresa.Id">@empresa.RazonSocial</option>
            }
        </select>
        <label class="casilla">
            <input type="checkbox" @bind="_incluirInactivos" @bind:after="() => EjecutarAsync(CargarUsuariosAsync)" /> @T["usuarios.incluirInactivos"]
        </label>
    </div>

    @if (Filtrados().Count == 0)
    {
        <div class="vacio"><Icono Nombre="usuarios" Tamano="36" /><p>@T["usuarios.vacio"]</p></div>
    }
    else
    {
        <div class="tabla-contenedor">
            <table class="tabla">
                <thead>
                    <tr>
                        <th>@T["comun.nombre"]</th>
                        <th>@T["comun.rol"]</th>
                        <th>@T["comun.empresa"]</th>
                        <th>@T["perfil.idioma"]</th>
                        <th>@T["usuarios.acceso"]</th>
                        <th>@T["comun.estado"]</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (UsuarioDto usuario in Filtrados())
                    {
                        <tr>
                            <td>
                                <div class="celda-principal">
                                    <strong>@usuario.NombreCompleto</strong>
                                    <span class="tenue">@usuario.Correo</span>
                                </div>
                            </td>
                            <td>
                                <span class="etiqueta etiqueta-info">@T.Enumerado(usuario.Rol)</span>
                                @if (usuario.Permisos.Count > 0)
                                {
                                    <span class="etiqueta etiqueta-violeta" title="@T["usuarios.permisosPersonalizados"]">+@usuario.Permisos.Count</span>
                                }
                            </td>
                            <td title="@NombresDeEmpresas(usuario.EmpresasAdicionales)">@DescripcionDeEmpresas(usuario)</td>
                            <td>@T.Enumerado(usuario.Idioma)</td>
                            <td>
                                @if (usuario.TieneContrasenaLocal)
                                {
                                    <span>@T["usuarios.accesoLocal"]</span>
                                    @if (usuario.RequiereCambioDeContrasena)
                                    {
                                        <span class="etiqueta etiqueta-advertencia">@T["usuarios.cambioPendiente"]</span>
                                    }
                                }
                                else
                                {
                                    <span>@T["usuarios.accesoEntra"]</span>
                                }
                            </td>
                            <td><span class="etiqueta @(usuario.Activo ? "etiqueta-ok" : "etiqueta-error")">@(usuario.Activo ? T["comun.activo"] : T["comun.inactivo"])</span></td>
                            <td class="acciones-fila">
                                @if (EsLocal)
                                {
                                    <button type="button" class="boton-icono" title="@T["usuarios.restablecer"]" @onclick="() => PedirRestablecer(usuario)"><Icono Nombre="llave" Tamano="18" /></button>
                                }
                                <button type="button" class="boton-icono" title="@T["comun.editar"]" @onclick="() => Editar(usuario)"><Icono Nombre="editar" Tamano="18" /></button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

<Dialogo Visible="_modelo is not null" Titulo="@(_modelo?.Id is null ? T["usuarios.nuevo"] : T["usuarios.editar"])" Ancho="true" AlCerrar="() => _modelo = null">
    <ChildContent>
        @if (_modelo is { } m)
        {
            <div class="formulario formulario-3">
                <div class="campo">
                    <label for="u-nombre">@T["comun.nombre"]</label>
                    <input id="u-nombre" type="text" maxlength="200" @bind="m.NombreCompleto" />
                </div>
                <div class="campo">
                    <label for="u-correo">@T["comun.correo"]</label>
                    <input id="u-correo" type="email" maxlength="200" @bind="m.Correo" />
                </div>
                <div class="campo">
                    <label for="u-rol">@T["comun.rol"]</label>
                    <select id="u-rol" @bind="m.Rol" @bind:after="() => m.AjustarARol()">
                        <option value="@RolUsuario.ClienteEmpresa">@T.Enumerado(RolUsuario.ClienteEmpresa)</option>
                        <option value="@RolUsuario.OperadorNomina">@T.Enumerado(RolUsuario.OperadorNomina)</option>
                        <option value="@RolUsuario.Administrador">@T.Enumerado(RolUsuario.Administrador)</option>
                    </select>
                </div>
                <div class="campo">
                    <label for="u-empresa">@T["usuarios.empresaPrincipal"]</label>
                    <select id="u-empresa" disabled="@(m.Rol != RolUsuario.ClienteEmpresa)" value="@(m.EmpresaId?.ToString() ?? string.Empty)"
                            @onchange="e => m.EmpresaId = Guid.TryParse(e.Value?.ToString(), out Guid id) ? id : null">
                        <option value="">@(m.Rol == RolUsuario.ClienteEmpresa ? T["comun.seleccioneEmpresa"] : T["usuarios.transversal"])</option>
                        @foreach (EmpresaDto empresa in _empresas)
                        {
                            <option value="@empresa.Id">@empresa.RazonSocial</option>
                        }
                    </select>
                    <span class="ayuda">@T["usuarios.empresaAyuda"]</span>
                </div>
                <div class="campo">
                    <label for="u-idioma">@T["perfil.idioma"]</label>
                    <select id="u-idioma" @bind="m.Idioma">
                        <option value="@Idioma.Espanol">@T.Enumerado(Idioma.Espanol)</option>
                        <option value="@Idioma.Ingles">@T.Enumerado(Idioma.Ingles)</option>
                    </select>
                </div>
                <div class="campo">
                    <label class="casilla" style="margin-top:1.6rem"><input type="checkbox" @bind="m.Activo" /> @T["comun.activo"]</label>
                </div>
                @if (EsLocal && m.Id is null)
                {
                    <div class="campo">
                        <label for="u-contrasena">@T["usuarios.contrasenaInicial"]</label>
                        <input id="u-contrasena" type="password" autocomplete="new-password" @bind="m.ContrasenaInicial" />
                        <span class="ayuda">@T["perfil.reglasContrasena"]</span>
                    </div>
                }
                else if (!EsLocal && m.Id is null)
                {
                    <div class="campo campo-ancho">
                        <span class="ayuda">@T["usuarios.altaEntraAyuda"]</span>
                    </div>
                }

                @if (m.Rol == RolUsuario.ClienteEmpresa)
                {
                    @* Un usuario de empresa cliente sólo ve y opera su empresa principal y éstas. *@
                    <div class="seccion-formulario">
                        <h3>@T["usuarios.otrasEmpresas"]</h3>
                        <p class="tenue">@T["usuarios.otrasEmpresasAyuda"]</p>
                    </div>
                    <div class="campo-ancho permisos">
                        @foreach (EmpresaDto empresa in _empresas.Where(e => e.Id != m.EmpresaId))
                        {
                            <label class="casilla">
                                <input type="checkbox" checked="@m.EmpresasAdicionales.Contains(empresa.Id)" @onchange="e => AlternarEmpresa(m, empresa.Id, e)" />
                                @empresa.RazonSocial
                            </label>
                        }
                    </div>
                }

                <div class="seccion-formulario">
                    <h3>@T["usuarios.permisos"]</h3>
                    <p class="tenue">@T["usuarios.permisosAyuda"]</p>
                </div>
                <div class="campo-ancho permisos">
                    @foreach (AccionDelSistema accion in Acciones)
                    {
                        bool predeterminada = PermisosPorRol.Predeterminadas(m.Rol).Contains(accion);
                        bool concedible = PermisosPorRol.PuedeConcederse(m.Rol, accion);
                        <div class="permiso">
                            <span>@T.Enumerado(accion)</span>
                            @if (concedible)
                            {
                                <select value="@m.Permisos[accion]" @onchange="@(e => CambiarPermiso(m, accion, e))">
                                    <option value="@EstadoDePermiso.SegunRol">@(predeterminada ? T["usuarios.permisoSegunRolSi"] : T["usuarios.permisoSegunRolNo"])</option>
                                    <option value="@EstadoDePermiso.Conceder">@T["usuarios.permisoConceder"]</option>
                                    <option value="@EstadoDePermiso.Negar">@T["usuarios.permisoNegar"]</option>
                                </select>
                            }
                            else
                            {
                                @* Exclusiva de nómina y administración: ni un permiso personalizado la concede a una empresa cliente. *@
                                <select disabled title="@T["usuarios.permisoNoDisponible"]">
                                    <option>@T["usuarios.permisoNoDisponible"]</option>
                                </select>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    </ChildContent>
    <Pie>
        <button type="button" class="boton" @onclick="() => _modelo = null">@T["comun.cancelar"]</button>
        <button type="button" class="boton boton-primario" disabled="@EstaCargando" @onclick="GuardarAsync">@T["comun.guardar"]</button>
    </Pie>
</Dialogo>

<Dialogo Visible="_restablecer is not null" Titulo="@T["usuarios.restablecer"]" AlCerrar="() => _restablecer = null">
    <ChildContent>
        <p>@T.Formato("usuarios.restablecerDetalle", _restablecer?.NombreCompleto ?? string.Empty)</p>
        <div class="formulario-apilado">
            <div class="campo">
                <label for="r-nueva">@T["perfil.contrasenaNueva"]</label>
                <input id="r-nueva" type="password" autocomplete="new-password" @bind="_nuevaContrasena" />
            </div>
            <div class="campo">
                <label for="r-confirmacion">@T["perfil.contrasenaConfirmacion"]</label>
                <input id="r-confirmacion" type="password" autocomplete="new-password" @bind="_confirmacion" />
            </div>
            <span class="ayuda">@T["perfil.reglasContrasena"]</span>
        </div>
    </ChildContent>
    <Pie>
        <button type="button" class="boton" @onclick="() => _restablecer = null">@T["comun.cancelar"]</button>
        <button type="button" class="boton boton-primario" disabled="@EstaCargando" @onclick="RestablecerAsync">@T["usuarios.restablecer"]</button>
    </Pie>
</Dialogo>

@code {
    private static readonly AccionDelSistema[] Acciones =
        [.. Enum.GetValues<AccionDelSistema>().Where(static a => a != AccionDelSistema.NoEspecificado)];

    private IReadOnlyList<UsuarioDto> _usuarios = [];
    private IReadOnlyList<EmpresaDto> _empresas = [];
    private Guid? _filtroEmpresa;
    private bool _incluirInactivos;
    private string? _texto;

    private ModeloUsuario? _modelo;
    private UsuarioDto? _restablecer;
    private string? _nuevaContrasena;
    private string? _confirmacion;

    /// <summary>Tri-estado de un permiso respecto de lo que concede el rol.</summary>
    private enum EstadoDePermiso
    {
        /// <summary>Se aplica lo que concede el rol.</summary>
        SegunRol,

        /// <summary>Se concede aunque el rol no lo incluya.</summary>
        Conceder,

        /// <summary>Se niega aunque el rol lo incluya.</summary>
        Negar,
    }

    /// <summary>Indica si el portal usa cuentas locales con contraseña.</summary>
    /// <value><c>true</c> en modo local: se pide la contraseña inicial al dar de alta.</value>
    private bool EsLocal => Identidad.Value.EsLocal;

    /// <summary>Cambia el estado de un permiso en el formulario.</summary>
    /// <param name="modelo">Usuario en edición.</param>
    /// <param name="accion">Acción del permiso.</param>
    /// <param name="argumentos">Evento del selector del permiso.</param>
    private static void CambiarPermiso(ModeloUsuario modelo, AccionDelSistema accion, ChangeEventArgs argumentos)
        => modelo.Permisos[accion] = Enum.TryParse(argumentos.Value?.ToString(), out EstadoDePermiso estado) ? estado : EstadoDePermiso.SegunRol;

    /// <summary>Añade o quita una empresa adicional del usuario en edición.</summary>
    /// <param name="modelo">Usuario en edición.</param>
    /// <param name="empresaId">Empresa de la casilla.</param>
    /// <param name="argumentos">Evento de la casilla.</param>
    private static void AlternarEmpresa(ModeloUsuario modelo, Guid empresaId, ChangeEventArgs argumentos)
    {
        if (argumentos.Value is true)
        {
            modelo.EmpresasAdicionales.Add(empresaId);
        }
        else
        {
            modelo.EmpresasAdicionales.Remove(empresaId);
        }
    }

    /// <summary>La empresa principal y, si las hay, cuántas adicionales tiene.</summary>
    /// <param name="usuario">Usuario de la fila.</param>
    /// <returns>El texto de la columna; «transversal» si no pertenece a ninguna empresa.</returns>
    private string DescripcionDeEmpresas(UsuarioDto usuario)
        => usuario.EmpresaRazonSocial is not { } principal
            ? T["usuarios.transversal"]
            : usuario.EmpresasAdicionales.Count == 0 ? principal : $"{principal} +{usuario.EmpresasAdicionales.Count}";

    /// <summary>Une las razones sociales de unas empresas.</summary>
    /// <param name="empresas">Empresas.</param>
    /// <returns>Las razones sociales separadas por comas.</returns>
    private string NombresDeEmpresas(IReadOnlyList<Guid> empresas)
        => string.Join(", ", _empresas.Where(e => empresas.Contains(e.Id)).Select(e => e.RazonSocial));

    /// <inheritdoc/>
    protected override async Task CargarDatosAsync()
    {
        _empresas = await Casos.ConsultarAsync<ListarEmpresasQuery, IReadOnlyList<EmpresaDto>>(new ListarEmpresasQuery(SoloActivas: false));
        await CargarUsuariosAsync();
    }

    /// <summary>Carga los usuarios con los filtros elegidos.</summary>
    /// <returns>Tarea que finaliza al cargarlos.</returns>
    private async Task CargarUsuariosAsync()
        => _usuarios = await Casos.ConsultarAsync<ListarUsuariosQuery, IReadOnlyList<UsuarioDto>>(new ListarUsuariosQuery(_filtroEmpresa, _incluirInactivos));

    /// <summary>Filtra los usuarios por nombre o correo.</summary>
    /// <returns>Los usuarios visibles.</returns>
    private IReadOnlyList<UsuarioDto> Filtrados()
    {
        if (string.IsNullOrWhiteSpace(_texto))
        {
            return _usuarios;
        }

        string texto = _texto.Trim();
        return _usuarios
            .Where(u => u.NombreCompleto.Contains(texto, StringComparison.OrdinalIgnoreCase)
                || u.Correo.Contains(texto, StringComparison.OrdinalIgnoreCase))
            .ToList();
    }

    /// <summary>Filtra por otra empresa.</summary>
    /// <param name="argumentos">Evento del selector de empresa.</param>
    /// <returns>Tarea que finaliza al cargar los usuarios.</returns>
    private Task CambiarFiltroEmpresaAsync(ChangeEventArgs argumentos)
    {
        _filtroEmpresa = Guid.TryParse(argumentos.Value?.ToString(), out Guid id) ? id : null;
        return EjecutarAsync(CargarUsuariosAsync);
    }

    /// <summary>Abre el formulario de un usuario nuevo en la empresa de trabajo.</summary>
    private void Nuevo()
    {
        LimpiarMensajes();
        _modelo = ModeloUsuario.Nuevo(Estado.EmpresaId);
    }

    /// <summary>Abre el formulario con los datos de un usuario.</summary>
    /// <param name="usuario">Usuario a editar.</param>
    private void Editar(UsuarioDto usuario)
    {
        LimpiarMensajes();
        _modelo = ModeloUsuario.Desde(usuario);
    }

    /// <summary>
    /// Guarda el usuario del formulario; si el administrador se editó a sí
    /// mismo, recarga su identidad para reflejar los permisos.
    /// </summary>
    /// <returns>Tarea que finaliza al recargar.</returns>
    private Task GuardarAsync() => EjecutarAsync(async () =>
    {
        if (_modelo is not { } m)
        {
            return;
        }

        UsuarioDto guardado = await Casos.EjecutarAsync<GuardarUsuarioCommand, UsuarioDto>(
            new GuardarUsuarioCommand(m.Id, m.ARequest(EsLocal)));

        _modelo = null;
        MensajeDeExito = T.Formato("usuarios.guardado", guardado.NombreCompleto);
        await CargarUsuariosAsync();

        // Si el administrador se editó a sí mismo, la navegación debe reflejarlo.
        if (guardado.Id == ContextoDeUsuario.UsuarioId)
        {
            await ContextoDeUsuario.RecargarAsync();
        }
    });

    /// <summary>Abre el diálogo para asignar una contraseña temporal.</summary>
    /// <param name="usuario">Usuario afectado.</param>
    private void PedirRestablecer(UsuarioDto usuario)
    {
        LimpiarMensajes();
        _nuevaContrasena = null;
        _confirmacion = null;
        _restablecer = usuario;
    }

    /// <summary>Asigna la contraseña temporal si la confirmación coincide.</summary>
    /// <returns>Tarea que finaliza al recargar o al mostrar el error.</returns>
    private Task RestablecerAsync() => EjecutarAsync(async () =>
    {
        if (_restablecer is not { } usuario)
        {
            return;
        }

        if (!string.Equals(_nuevaContrasena, _confirmacion, StringComparison.Ordinal))
        {
            MostrarError(T["perfil.contrasenasNoCoinciden"]);
            return;
        }

        await Casos.EjecutarAsync(new RestablecerContrasenaCommand(usuario.Id, _nuevaContrasena ?? string.Empty));
        _restablecer = null;
        MensajeDeExito = T.Formato("usuarios.contrasenaRestablecida", usuario.NombreCompleto);
        await CargarUsuariosAsync();
    });

    /// <summary>Estado editable de un usuario.</summary>
    private sealed class ModeloUsuario
    {
        /// <summary>Obtiene el identificador.</summary>
        /// <value><c>null</c> para un usuario nuevo.</value>
        public Guid? Id { get; init; }

        /// <summary>Obtiene o establece el nombre completo.</summary>
        /// <value>Obligatorio.</value>
        public string NombreCompleto { get; set; } = string.Empty;

        /// <summary>Obtiene o establece el correo, que es el nombre de acceso.</summary>
        /// <value>Obligatorio y único.</value>
        public string Correo { get; set; } = string.Empty;

        /// <summary>Obtiene o establece el rol.</summary>
        /// <value>Empresa cliente para un usuario nuevo.</value>
        public RolUsuario Rol { get; set; } = RolUsuario.ClienteEmpresa;

        /// <summary>Obtiene o establece la empresa principal.</summary>
        /// <value>Sólo para la empresa cliente.</value>
        public Guid? EmpresaId { get; set; }

        /// <summary>Obtiene las empresas adicionales.</summary>
        /// <value>Sólo para la empresa cliente; se excluye la principal al guardar.</value>
        public HashSet<Guid> EmpresasAdicionales { get; } = [];

        /// <summary>Obtiene o establece si el usuario está activo.</summary>
        /// <value><c>true</c> para un usuario nuevo.</value>
        public bool Activo { get; set; } = true;

        /// <summary>Obtiene o establece el idioma.</summary>
        /// <value>Español para un usuario nuevo.</value>
        public Idioma Idioma { get; set; } = Idioma.Espanol;

        /// <summary>Obtiene o establece la contraseña inicial.</summary>
        /// <value>Sólo se envía al dar de alta en modo local.</value>
        public string? ContrasenaInicial { get; set; }

        /// <summary>Obtiene el estado de cada permiso respecto del rol.</summary>
        /// <value>Todos «según el rol» para un usuario nuevo.</value>
        public Dictionary<AccionDelSistema, EstadoDePermiso> Permisos { get; } = Acciones.ToDictionary(a => a, _ => EstadoDePermiso.SegunRol);

        /// <summary>Crea el modelo de un usuario nuevo.</summary>
        /// <param name="empresaDeTrabajo">Empresa que se propone como principal.</param>
        /// <returns>El modelo editable.</returns>
        public static ModeloUsuario Nuevo(Guid? empresaDeTrabajo) => new() { EmpresaId = empresaDeTrabajo };

        /// <summary>Crea el modelo con los datos y permisos de un usuario.</summary>
        /// <param name="u">Usuario.</param>
        /// <returns>El modelo editable.</returns>
        public static ModeloUsuario Desde(UsuarioDto u)
        {
            var modelo = new ModeloUsuario
            {
                Id = u.Id,
                NombreCompleto = u.NombreCompleto,
                Correo = u.Correo,
                Rol = u.Rol,
                EmpresaId = u.EmpresaId,
                Activo = u.Activo,
                Idioma = u.Idioma,
            };

            modelo.EmpresasAdicionales.UnionWith(u.EmpresasAdicionales);

            foreach (PermisoDto permiso in u.Permisos)
            {
                modelo.Permisos[permiso.Accion] = permiso.Habilitado ? EstadoDePermiso.Conceder : EstadoDePermiso.Negar;
            }

            return modelo;
        }

        /// <summary>
        /// Los roles transversales no pertenecen a ninguna empresa, y a un usuario
        /// de empresa cliente no se le conservan acciones exclusivas de nómina.
        /// </summary>
        public void AjustarARol()
        {
            if (Rol != RolUsuario.ClienteEmpresa)
            {
                EmpresaId = null;
                EmpresasAdicionales.Clear();
            }

            foreach (AccionDelSistema accion in Acciones.Where(a => !PermisosPorRol.PuedeConcederse(Rol, a)))
            {
                Permisos[accion] = EstadoDePermiso.SegunRol;
            }
        }

        /// <summary>
        /// Arma la petición; sólo envía los permisos que cambian algo respecto
        /// del rol y que el rol admite.
        /// </summary>
        /// <param name="modoLocal">Si el portal usa cuentas locales.</param>
        /// <returns>La petición de guardado.</returns>
        public GuardarUsuarioRequest ARequest(bool modoLocal)
        {
            IReadOnlyList<AccionDelSistema> predeterminadas = PermisosPorRol.Predeterminadas(Rol);

            // Sólo se guardan las excepciones que cambian algo respecto del rol
            // y que el rol admite.
            List<PermisoDto> permisos = Permisos
                .Where(p => (p.Value == EstadoDePermiso.Conceder && !predeterminadas.Contains(p.Key) && PermisosPorRol.PuedeConcederse(Rol, p.Key))
                    || (p.Value == EstadoDePermiso.Negar && predeterminadas.Contains(p.Key)))
                .Select(p => new PermisoDto(p.Key, p.Value == EstadoDePermiso.Conceder))
                .ToList();

            bool esCliente = Rol == RolUsuario.ClienteEmpresa;

            return new GuardarUsuarioRequest(
                NombreCompleto.Trim(), Correo.Trim(), Rol, esCliente ? EmpresaId : null,
                Activo, Idioma, modoLocal && Id is null && !string.IsNullOrEmpty(ContrasenaInicial) ? ContrasenaInicial : null,
                permisos,
                esCliente ? [.. EmpresasAdicionales.Where(id => id != EmpresaId)] : []);
        }
    }
}
