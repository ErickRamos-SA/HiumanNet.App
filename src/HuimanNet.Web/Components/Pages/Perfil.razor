@page "/perfil"
@inherits ComponenteDelPortal
@inject IJSRuntime Js
@inject Microsoft.Extensions.Options.IOptions<HuimanNet.Infrastructure.Configuracion.OpcionesDeIdentidad> Identidad

<PageTitle>@T["perfil.titulo"] · HuimanNet</PageTitle>

<div class="encabezado-pagina">
    <div>
        <h1>@T["perfil.titulo"]</h1>
        <p class="subtitulo">@T["perfil.subtitulo"]</p>
    </div>
</div>

@if (CambiarContrasena == 1 || (Inicializado && ContextoDeUsuario.EstaAutenticado && ContextoDeUsuario.RequiereCambioDeContrasena))
{
    <div class="aviso aviso-advertencia"><Icono Nombre="llave" /> <span>@T["perfil.cambioObligatorio"]</span></div>
}

<Mensajes Error="@MensajeDeError" Exito="@MensajeDeExito" />

@if (ContextoDeUsuario.EstaAutenticado)
{
    <div class="rejilla-2">
        <section class="tarjeta">
            <header class="tarjeta-cabecera"><h2>@T["perfil.datos"]</h2></header>
            <dl class="definiciones">
                <dt>@T["comun.nombre"]</dt>
                <dd>@ContextoDeUsuario.NombreCompleto</dd>
                <dt>@T["comun.correo"]</dt>
                <dd>@ContextoDeUsuario.Correo</dd>
                <dt>@T["comun.rol"]</dt>
                <dd>@T.Enumerado(ContextoDeUsuario.Rol)</dd>
                <dt>@(ContextoDeUsuario.EmpresasDelUsuario.Count > 1 ? T["perfil.empresas"] : T["comun.empresa"])</dt>
                <dd>@(ContextoDeUsuario.EsTransversal ? T["perfil.accesoTransversal"] : string.Join(", ", ContextoDeUsuario.EmpresasDelUsuario.Select(e => e.RazonSocial)))</dd>
            </dl>
        </section>

        <section class="tarjeta">
            <header class="tarjeta-cabecera"><h2>@T["perfil.preferencias"]</h2></header>
            <div class="formulario-apilado">
                <label for="idioma">@T["perfil.idioma"]</label>
                <select id="idioma" @bind="_idioma">
                    <option value="@Idioma.Espanol">Español</option>
                    <option value="@Idioma.Ingles">English</option>
                </select>
                <span class="tenue">@T["perfil.idiomaAyuda"]</span>
                <div>
                    <button type="button" class="boton boton-primario" disabled="@EstaCargando" @onclick="GuardarIdiomaAsync">
                        <Icono Nombre="check" /> @T["comun.guardar"]
                    </button>
                </div>
            </div>
        </section>
    </div>

    @if (Identidad.Value.EsLocal)
    {
        <section class="tarjeta">
            <header class="tarjeta-cabecera"><h2>@T["perfil.cambiarContrasena"]</h2></header>
            <div class="formulario formulario-3">
                <div class="campo">
                    <label for="actual">@T["perfil.contrasenaActual"]</label>
                    <input id="actual" type="password" autocomplete="current-password" @bind="_actual" />
                </div>
                <div class="campo">
                    <label for="nueva">@T["perfil.contrasenaNueva"]</label>
                    <input id="nueva" type="password" autocomplete="new-password" @bind="_nueva" />
                </div>
                <div class="campo">
                    <label for="confirmacion">@T["perfil.contrasenaConfirmacion"]</label>
                    <input id="confirmacion" type="password" autocomplete="new-password" @bind="_confirmacion" />
                </div>
                <div class="campo-ancho acciones">
                    <span class="tenue">@T["perfil.reglasContrasena"]</span>
                    <span class="espaciador"></span>
                    <button type="button" class="boton boton-primario" disabled="@EstaCargando" @onclick="CambiarContrasenaAsync">
                        <Icono Nombre="llave" /> @T["perfil.cambiarContrasena"]
                    </button>
                </div>
            </div>
        </section>
    }

    <section class="tarjeta">
        <header class="tarjeta-cabecera"><h2>@T["perfil.accionesPermitidas"]</h2></header>
        <div class="casillas">
            @foreach (AccionDelSistema accion in ContextoDeUsuario.Acciones.OrderBy(a => (int)a))
            {
                <span class="casilla"><Icono Nombre="check" Tamano="16" Clase="tenue" /> @T.Enumerado(accion)</span>
            }
        </div>
    </section>
}

@code {
    private Idioma _idioma = Idioma.Espanol;
    private string _actual = string.Empty;
    private string _nueva = string.Empty;
    private string _confirmacion = string.Empty;

    /// <summary>Indica que se llegó aquí porque la contraseña debe cambiarse.</summary>
    [SupplyParameterFromQuery(Name = "cambiarContrasena")]
    public int? CambiarContrasena { get; set; }

    /// <inheritdoc/>
    protected override Task CargarDatosAsync()
    {
        _idioma = ContextoDeUsuario.Idioma;
        return Task.CompletedTask;
    }

    /// <summary>Guarda el idioma en el perfil y en el navegador y recarga el portal en ese idioma.</summary>
    /// <returns>Tarea que finaliza al iniciar la recarga.</returns>
    private Task GuardarIdiomaAsync() => EjecutarAsync(async () =>
    {
        await Casos.EjecutarAsync(new ActualizarPreferenciasCommand(_idioma));
        await Js.InvokeVoidAsync("huimanNet.guardarIdioma", _idioma.Codigo());

        // Recarga completa: el circuito nuevo arranca ya en el idioma elegido.
        Navegacion.NavigateTo("perfil", forceLoad: true);
    });

    /// <summary>Cambia la contraseña si la confirmación coincide y recarga la identidad.</summary>
    /// <returns>Tarea que finaliza al cambiarla o al mostrar el error.</returns>
    private async Task CambiarContrasenaAsync()
    {
        if (!string.Equals(_nueva, _confirmacion, StringComparison.Ordinal))
        {
            MostrarError(T["perfil.contrasenasNoCoinciden"]);
            return;
        }

        bool correcto = await EjecutarAsync(async () =>
        {
            await Casos.EjecutarAsync(new CambiarContrasenaCommand(_actual, _nueva));
            await ContextoDeUsuario.RecargarAsync();
        });

        if (correcto)
        {
            _actual = _nueva = _confirmacion = string.Empty;
            CambiarContrasena = null;
            MensajeDeExito = T["perfil.contrasenaCambiada"];
        }
    }
}
