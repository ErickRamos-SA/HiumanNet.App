@page "/error"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@layout LayoutDeAcceso
@inject Traductor T

<PageTitle>@T["error.titulo"] · HuimanNet</PageTitle>

<div class="acceso">
    <div class="acceso-tarjeta">
        <div class="acceso-marca">
            <span class="logo">H</span>
            <span class="logo-texto">HuimanNet</span>
        </div>
        <h1>@T["error.titulo"]</h1>
        <p class="subtitulo">@T["error.descripcion"]</p>
        @if (_referencia is not null)
        {
            <p class="tenue">@T["error.referencia"]: <code>@_referencia</code></p>
        }
        <a class="boton boton-primario boton-bloque" href="/">@T["comun.volverAlInicio"]</a>
    </div>
</div>

@code {
    private string? _referencia;

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    /// <inheritdoc/>
    protected override void OnInitialized()
    {
        T.Cambiar(IdiomaDeLaPeticion.Detectar(HttpContext));
        _referencia = System.Diagnostics.Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
    }
}
