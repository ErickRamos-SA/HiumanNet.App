@page "/entrar"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@layout LayoutDeAcceso
@inject Traductor T
@inject Microsoft.Extensions.Options.IOptions<HuimanNet.Infrastructure.Configuracion.OpcionesDeIdentidad> Identidad

@* Página estática (sin circuito) para que el formulario pueda emitir la
   cookie de sesión con un POST normal protegido contra falsificación. *@

<PageTitle>@T["acceso.titulo"] · HuimanNet</PageTitle>

<div class="acceso">
    <div class="acceso-tarjeta">
        <div class="acceso-marca">
            <span class="logo">H</span>
            <span class="logo-texto">HuimanNet</span>
        </div>

        <h1>@T["acceso.titulo"]</h1>
        <p class="subtitulo">@T["acceso.subtitulo"]</p>

        @if (Error is not null)
        {
            <div class="aviso aviso-error">@T["acceso.credencialesInvalidas"]</div>
        }

        @if (Identidad.Value.EsLocal)
        {
            <form method="post" action="autenticacion/local" class="formulario-apilado">
                <AntiforgeryToken />
                <input type="hidden" name="volverA" value="@Destino" />

                <label for="correo">@T["acceso.correo"]</label>
                <input id="correo" name="correo" type="email" autocomplete="username" required autofocus />

                <label for="contrasena">@T["acceso.contrasena"]</label>
                <input id="contrasena" name="contrasena" type="password" autocomplete="current-password" required />

                <button type="submit" class="boton boton-primario boton-bloque">@T["acceso.entrar"]</button>
            </form>
        }
        else
        {
            <a class="boton boton-primario boton-bloque" href="@($"autenticacion/entrar?volverA={Uri.EscapeDataString(Destino)}")">
                @T["acceso.entrarConMicrosoft"]
            </a>
        }

        <div class="acceso-idiomas">
            <Icono Nombre="idioma" Tamano="16" />
            <a href="@EnlaceDeIdioma("es")" class="@(T.Idioma == Idioma.Espanol ? "activo" : null)">Español</a>
            <span>·</span>
            <a href="@EnlaceDeIdioma("en")" class="@(T.Idioma == Idioma.Ingles ? "activo" : null)">English</a>
        </div>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    /// <summary>Página a la que se vuelve tras iniciar sesión.</summary>
    [SupplyParameterFromQuery(Name = "volverA")]
    public string? VolverA { get; set; }

    /// <summary>Indica que el intento anterior falló.</summary>
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    private string Destino => HuimanNet.Web.Endpoints.AutenticacionEndpoints.RutaLocalSegura(VolverA);

    /// <inheritdoc/>
    protected override void OnInitialized() => T.Cambiar(IdiomaDeLaPeticion.Detectar(HttpContext));

    private string EnlaceDeIdioma(string codigo)
        => $"autenticacion/idioma?codigo={codigo}&volverA={Uri.EscapeDataString("/entrar?volverA=" + Uri.EscapeDataString(Destino))}";
}
