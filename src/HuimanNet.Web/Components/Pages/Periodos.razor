@page "/periodos"
@inherits ComponenteDelPortal

<PageTitle>@T["periodos.titulo"] · HuimanNet</PageTitle>

<div class="encabezado-pagina">
    <div>
        <h1>@T["periodos.titulo"]</h1>
        <p class="subtitulo">@T["periodos.subtitulo"]</p>
    </div>
    @if (ContextoDeUsuario.Puede(AccionDelSistema.GestionarPeriodos) && !FaltaEmpresa)
    {
        <button type="button" class="boton boton-primario" @onclick="AbrirDialogo">
            <Icono Nombre="agregar" /> @T["periodos.abrir"]
        </button>
    }
</div>

<Mensajes Error="@MensajeDeError" Exito="@MensajeDeExito" />

@if (FaltaEmpresa)
{
    <AvisoDeEmpresa />
}
else
{
    <section class="tarjeta tarjeta-tabla">
        <div class="barra-herramientas">
            <label class="casilla">
                <input type="checkbox" checked="@_incluirCerrados" @onchange="AlternarCerradosAsync" />
                @T["periodos.incluirCerrados"]
            </label>
        </div>

        @if (_periodos.Count == 0)
        {
            <div class="vacio">
                <Icono Nombre="periodos" Tamano="36" />
                <p>@T["periodos.sinPeriodos"]</p>
            </div>
        }
        else
        {
            <div class="tabla-contenedor">
                <table class="tabla">
                    <thead>
                        <tr>
                            <th>@T["comun.periodo"]</th>
                            <th>@T["comun.estado"]</th>
                            <th>@T["periodos.fechaLimite"]</th>
                            <th class="numero">@T["periodos.documentosCliente"]</th>
                            <th class="numero">@T["periodos.documentosResultado"]</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (PeriodoDto periodo in _periodos)
                        {
                            <tr>
                                <td>
                                    <div class="celda-principal">
                                        <strong>@periodo.Clave</strong>
                                        <span class="tenue">@periodo.Descripcion</span>
                                    </div>
                                </td>
                                <td><EtiquetaDePeriodo Estado="periodo.Estado" /></td>
                                <td>@(periodo.FechaLimiteCarga is { } limite ? Fecha(limite) : "—")</td>
                                <td class="numero">@periodo.DocumentosDelCliente</td>
                                <td class="numero">@periodo.DocumentosDeResultado</td>
                                <td class="acciones-fila">
                                    <div class="acciones" style="justify-content:flex-end">
                                        <a class="boton boton-pequeno" href="@($"periodos/{periodo.Id}/documentos")">
                                            <Icono Nombre="documentos" Tamano="16" /> @T["periodos.documentos"]
                                        </a>
                                        @if (ContextoDeUsuario.Puede(AccionDelSistema.CapturarIncidencias))
                                        {
                                            <a class="boton boton-pequeno" href="@($"incidencias?periodoId={periodo.Id}")">
                                                <Icono Nombre="incidencias" Tamano="16" /> @T["nav.incidencias"]
                                            </a>
                                        }
                                        @if (ContextoDeUsuario.Puede(AccionDelSistema.ConsultarNomina))
                                        {
                                            <a class="boton boton-pequeno" href="@($"nomina?periodoId={periodo.Id}")">
                                                <Icono Nombre="nomina" Tamano="16" /> @T["nav.nomina"]
                                            </a>
                                        }
                                        @if (ContextoDeUsuario.Puede(AccionDelSistema.GestionarPeriodos) && periodo.Estado.Siguiente() is { } siguiente)
                                        {
                                            <button type="button" class="boton boton-pequeno" disabled="@EstaCargando"
                                                    @onclick="() => CambiarEstadoAsync(periodo, siguiente)">
                                                <Icono Nombre="derecha" Tamano="16" /> @T[$"periodos.accion.{siguiente}"]
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
}

<Dialogo Visible="_dialogoAbierto" Titulo="@T["periodos.abrir"]" AlCerrar="CerrarDialogo">
    <ChildContent>
        <div class="formulario">
            <div class="campo">
                <label for="anio">@T["periodos.anio"]</label>
                <input id="anio" type="number" min="2000" max="2100" @bind="_anio" />
            </div>
            <div class="campo">
                <label for="mes">@T["periodos.mes"]</label>
                <select id="mes" @bind="_mes">
                    @for (int mes = 1; mes <= 12; mes++)
                    {
                        <option value="@mes">@T.Cultura.DateTimeFormat.GetMonthName(mes)</option>
                    }
                </select>
            </div>
            <div class="campo">
                <label for="consecutivo">@T["periodos.consecutivo"]</label>
                <input id="consecutivo" type="number" min="1" max="99" @bind="_consecutivo" />
                <span class="ayuda">@T["periodos.consecutivoAyuda"]</span>
            </div>
            <div class="campo">
                <label for="limite">@T["periodos.fechaLimite"]</label>
                <input id="limite" type="datetime-local" @bind="_fechaLimite" />
            </div>
            <div class="campo campo-ancho">
                <label for="descripcion">@T["comun.descripcion"]</label>
                <input id="descripcion" type="text" maxlength="200" @bind="_descripcion" placeholder="@T["periodos.descripcionEjemplo"]" />
            </div>
        </div>
    </ChildContent>
    <Pie>
        <button type="button" class="boton" @onclick="CerrarDialogo">@T["comun.cancelar"]</button>
        <button type="button" class="boton boton-primario" disabled="@EstaCargando" @onclick="AbrirPeriodoAsync">@T["periodos.abrir"]</button>
    </Pie>
</Dialogo>

@code {
    private IReadOnlyList<PeriodoDto> _periodos = [];
    private bool _incluirCerrados;
    private bool _dialogoAbierto;
    private int _anio;
    private int _mes;
    private int _consecutivo = 1;
    private DateTime? _fechaLimite;
    private string _descripcion = string.Empty;

    /// <inheritdoc/>
    protected override bool DependeDeEmpresa => true;

    /// <inheritdoc/>
    protected override async Task CargarDatosAsync()
    {
        if (FaltaEmpresa)
        {
            _periodos = [];
            return;
        }

        _periodos = await Casos.ConsultarAsync<ListarPeriodosQuery, IReadOnlyList<PeriodoDto>>(
            new ListarPeriodosQuery(EmpresaDeConsulta, _incluirCerrados));
    }

    /// <summary>Muestra u oculta los períodos cerrados.</summary>
    /// <param name="argumentos">Evento de la casilla.</param>
    /// <returns>Tarea que finaliza al recargar la lista.</returns>
    private Task AlternarCerradosAsync(ChangeEventArgs argumentos)
    {
        _incluirCerrados = argumentos.Value is true;
        return EjecutarAsync(CargarDatosAsync);
    }

    /// <summary>Avanza el estado de un período y recarga la lista.</summary>
    /// <param name="periodo">Período afectado.</param>
    /// <param name="nuevo">Estado siguiente.</param>
    /// <returns>Tarea que finaliza al recargar la lista.</returns>
    private Task CambiarEstadoAsync(PeriodoDto periodo, EstadoPeriodo nuevo) =>EjecutarAsync(async () =>
    {
        MensajeDeExito = null;
        await Casos.EjecutarAsync(new CambiarEstadoPeriodoCommand(periodo.Id, nuevo, null, periodo.EmpresaId));
        MensajeDeExito = T.Formato("periodos.estadoCambiado", periodo.Clave, T.Enumerado(nuevo));
        await CargarDatosAsync();
    });

    /// <summary>Abre el diálogo de apertura con el mes actual como propuesta.</summary>
    private void AbrirDialogo()
    {
        DateTime hoy = DateTime.Today;
        _anio = hoy.Year;
        _mes = hoy.Month;
        _consecutivo = 1;
        _descripcion = string.Empty;
        _fechaLimite = null;
        _dialogoAbierto = true;
    }

    /// <summary>Cierra el diálogo de apertura sin guardar.</summary>
    private void CerrarDialogo() => _dialogoAbierto = false;

    /// <summary>Abre el período capturado en el diálogo y recarga la lista.</summary>
    /// <returns>Tarea que finaliza al recargar la lista.</returns>
    private Task AbrirPeriodoAsync() => EjecutarAsync(async () =>
    {
        if (Estado.EmpresaId is not { } empresaId)
        {
            return;
        }

        PeriodoDto periodo = await Casos.EjecutarAsync<AbrirPeriodoCommand, PeriodoDto>(new AbrirPeriodoCommand(
            empresaId, _anio, _mes, _consecutivo, _descripcion,
            _fechaLimite is { } limite ? new DateTimeOffset(limite) : null));

        _dialogoAbierto = false;
        MensajeDeExito = T.Formato("periodos.abierto", periodo.Clave);
        await CargarDatosAsync();
    });
}
