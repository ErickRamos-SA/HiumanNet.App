<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:HuimanNet.App.ViewModels"
             xmlns:loc="clr-namespace:HuimanNet.App.Localizacion"
             xmlns:inc="clr-namespace:HuimanNet.Contracts.Incidencias;assembly=HuimanNet.Contracts"
             x:Class="HuimanNet.App.Views.IncidenciasPage"
             x:DataType="vm:IncidenciasViewModel"
             Title="{Binding Titulo}">

    <Grid RowDefinitions="Auto,Auto,*" Padding="12,12,12,0" RowSpacing="8">

        <VerticalStackLayout Grid.Row="0" Spacing="6">
            <Picker ItemsSource="{Binding NombresDePeriodos}"
                    SelectedIndex="{Binding IndiceDePeriodo}"
                    Title="{loc:T Clave=comun.periodo}" />
            <SearchBar Text="{Binding Texto}" Placeholder="{loc:T Clave=incidencias.buscar}" />
            <Label Text="{Binding Resumen}" Style="{StaticResource Tenue}" />
        </VerticalStackLayout>

        <Border Grid.Row="1" Style="{StaticResource Tarjeta}" IsVisible="{Binding TieneError}">
            <Label Text="{Binding MensajeDeError}" TextColor="{StaticResource Error}" />
        </Border>

        <RefreshView Grid.Row="2" Command="{Binding CargarCommand}" IsRefreshing="{Binding EstaOcupado, Mode=OneWay}">
            <CollectionView ItemsSource="{Binding Filas}" SelectionMode="None">
                <CollectionView.EmptyView>
                    <Label Text="{loc:T Clave=incidencias.vacio}" Style="{StaticResource Tenue}"
                           HorizontalTextAlignment="Center" Margin="0,40,0,0" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="inc:IncidenciaDto">
                        <Border Style="{StaticResource Tarjeta}" Margin="0,0,0,10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:IncidenciasViewModel}}, Path=EditarCommand, x:DataType=vm:IncidenciasViewModel}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8">
                                <Label Grid.Row="0" Grid.Column="0" FontAttributes="Bold">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding ClaveEmpleado}" />
                                            <Span Text=" · " />
                                            <Span Text="{Binding NombreEmpleado}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Label Grid.Row="0" Grid.Column="1" Text="{loc:T Clave=incidencias.capturada}"
                                       TextColor="{StaticResource Exito}" FontSize="12"
                                       IsVisible="{Binding Id, Converter={StaticResource NoNulo}}" />
                                <Label Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Tenue}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding RazonSocialNombre}" />
                                            <Span Text=" · " />
                                            <Span Text="{Binding Esquema, Converter={StaticResource Enumerado}}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <HorizontalStackLayout Grid.Row="2" Grid.ColumnSpan="2" Spacing="14" Margin="0,4,0,0">
                                    <HorizontalStackLayout Spacing="4">
                                        <Label Text="{loc:T Clave=incidencias.dias}" FontSize="13" Style="{StaticResource Tenue}" />
                                        <Label Text="{Binding DiasPeriodo}" FontSize="13" />
                                    </HorizontalStackLayout>
                                    <HorizontalStackLayout Spacing="4">
                                        <Label Text="{loc:T Clave=incidencias.ausentismos}" FontSize="13" Style="{StaticResource Tenue}" />
                                        <Label Text="{Binding Ausentismos}" FontSize="13" />
                                    </HorizontalStackLayout>
                                    <HorizontalStackLayout Spacing="4">
                                        <Label Text="{loc:T Clave=incidencias.gratificacion}" FontSize="13" Style="{StaticResource Tenue}" />
                                        <Label Text="{Binding Gratificacion, Converter={StaticResource Moneda}}" FontSize="13" />
                                    </HorizontalStackLayout>
                                </HorizontalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

    </Grid>

</ContentPage>
