<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource Fondo}, Dark={StaticResource FondoOscuro}}" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource Texto}, Dark={StaticResource TextoInverso}}" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <Style x:Key="Titulo" TargetType="Label">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="Subtitulo" TargetType="Label">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style x:Key="Tenue" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource Tenue}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Primario}" />
        <Setter Property="TextColor" Value="#FFFFFF" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource Borde}" />
                            <Setter Property="TextColor" Value="{StaticResource Tenue}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="Tarjeta" TargetType="Border">
        <Setter Property="Stroke" Value="{StaticResource Borde}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource Superficie}, Dark={StaticResource SuperficieOscura}}" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="StrokeShape" Value="RoundRectangle 8" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{StaticResource Primario}" />
        <Setter Property="Shell.ForegroundColor" Value="#FFFFFF" />
        <Setter Property="Shell.TitleColor" Value="#FFFFFF" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="{StaticResource Primario}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="#FFFFFF" />
        <Setter Property="Shell.TabBarTitleColor" Value="#FFFFFF" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="#B7C6D6" />
    </Style>

</ResourceDictionary>
